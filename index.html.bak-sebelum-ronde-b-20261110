        g.updateMatrixWorld(true);
        /* penempatan pakai PUSAT model (awan melayang, bukan alas tanah):
           geser salinan supaya pusat bbox tepat di titik grup. */
        var bb = new THREE.Box3().setFromObject(m);
        var c = bb.getCenter(new THREE.Vector3());
        m.position.set(-c.x, -c.y, -c.z);
        g.position.set(t.x, t.y, t.z);
        g.userData.kecepatan = t.kecepatan;
        g.userData.mats = mats;
        scene.add(g);
        awanList.push(g);
      });
    }, undefined, function(){
      if (sudah) return; sudah = true; clearTimeout(batas);
    });
