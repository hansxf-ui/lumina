    var a2 = acakVeg() * Math.PI * 2, r2 = 120 + acakVeg() * 160;
    tempat.push({
      x: Math.cos(a2) * r2, y: 42 + acakVeg() * 30, z: Math.sin(a2) * r2,
      lebar: 34 + acakVeg() * 30, kecepatan: 0.35 + acakVeg() * 0.5
    });
  }
  try {
    new THREE.GLTFLoader().load('awan-blender-v1.glb', function(gltf){
      if (sudah) return; sudah = true; clearTimeout(batas);
      var model = gltf.scene;
      /* material bersama: transparan + tanpa fog + tanpa depthWrite,
         persis perilaku sprite lama (opacity diatur loop animasi). */
      var mats = [];
      model.traverse(function(o){
        if (o.isMesh && o.material){
          var ms = Array.isArray(o.material) ? o.material : [o.material];
          ms.forEach(function(mt){
            mt.transparent = true; mt.depthWrite = false; mt.fog = false; mt.opacity = 0.75;
            if (mats.indexOf(mt) < 0) mats.push(mt);
          });
        }
      });
