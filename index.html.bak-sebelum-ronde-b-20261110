/* pusat bukit & sudut landai spiral (rad) tiap teras */
var BUKIT = { x:37, z:37 };
var LANDAI1 = -2.0, LANDAI2 = 0.4, LANDAI3 = 2.8;
/* pusat gundukan mercusuar (Fase 4) & sudut landainya — didefinisikan di sini
   karena tinggiTanah() di bawah memakainya (pantulan pola bukit) */
var MERCU = { x:-38, z:72 };
var LANDAI_MERCU = -0.8;
/* konstanta Fase 5 — didefinisikan di sini karena tinggiTanah() di bawah
   memakainya (pantulan pola MERCU) */
/* Gunung Awan: 5 teras (2.8/5.6/8.4/11.2/14) dengan landai spiral lebar;
   tiap pita = dataran teras di luar sektor + landai di dalam sektor */
var GUNUNG = { x:0, z:-225 };
var LANDAI_G = [1.5, -2.4, -0.5, 2.6, 0.2];
function tinggiGunung(d, a){
  if (d >= 58) return 0;
  if (d >= 47) return 2.8 * ((58 - d) / 11) * sektor(a, LANDAI_G[0]);
  if (d >= 38) return 2.8 + 2.8 * ((47 - d) / 9) * sektor(a, LANDAI_G[1]);
  if (d >= 30) return 5.6 + 2.8 * ((38 - d) / 8) * sektor(a, LANDAI_G[2]);
  if (d >= 23) return 8.4 + 2.8 * ((30 - d) / 7) * sektor(a, LANDAI_G[3]);
  if (d >= 17) return 11.2 + 2.8 * ((23 - d) / 6) * sektor(a, LANDAI_G[4]);
  return 14;
}
/* jembatan kayu pantai -> Pulau Kecil: segmen (-52,76) -> (-77,91) */
function jembatanInfo(x, z){
  var ax = -52, az = 76, bx = -77, bz = 91;
  var abx = bx - ax, abz = bz - az;
  var t = ((x - ax) * abx + (z - az) * abz) / (abx * abx + abz * abz);
  t = clamp(t, 0, 1);
  return { t:t, d:Math.hypot(x - (ax + abx * t), z - (az + abz * t)) };
}
function tinggiDekJembatan(t){
  if (t < 0.12) return 0.5 * t / 0.12;
  if (t > 0.88) return 0.5 * (1 - t) / 0.12;
  return 0.5;
}
/* profil gundukan mercusuar: 1 teras 2.5 m, landai di sektor LANDAI_MERCU,
   sisi lain dinding curam (terblokir aturan langkah seperti teras bukit) */
function tinggiMercu(d, a){
  if (d >= 8) return 0;
  if (d >= 4.2) return 2.5 * ((8 - d) / 3.8) * sektor(a, LANDAI_MERCU);
  return 2.5;
}
function bedaSudut(a, b){
  var d = (a - b) % (Math.PI * 2);
  if (d > Math.PI) d -= Math.PI * 2;
  if (d < -Math.PI) d += Math.PI * 2;
  return Math.abs(d);
}
/* faktor sektor landai: 1 di tengah jalur, 0 di luar, tepi melunak */
function sektor(a, ac){
  var s = clamp(1 - (bedaSudut(a, ac) - 0.30) / 0.24, 0, 1);
  return s * s * (3 - 2 * s);
}
/* profil bukit: 3 teras (1.8 / 3.6 / 5.4) — di luar sektor landai,
   pita antar-teras tetap di tinggi teras bawahnya = dinding curam */
function tinggiBukit(d, a){
  if (d >= 17.5) return 0;
  if (d >= 12.5) return 1.8 * ((17.5 - d) / 5) * sektor(a, LANDAI1);
  if (d >= 8)    return 1.8 + 1.8 * ((12.5 - d) / 4.5) * sektor(a, LANDAI2);
  if (d >= 4.5)  return 3.6 + 1.8 * ((8 - d) / 3.5) * sektor(a, LANDAI3);
  return 5.4;
}
/* tinggi permukaan yang bisa diinjak di titik (x, z) */
function tinggiTanah(x, z){
  var h = 0;
  var dx = x - BUKIT.x, dz = z - BUKIT.z;
  var d = Math.sqrt(dx * dx + dz * dz);
  if (d < 17.5){
    var hb = tinggiBukit(d, Math.atan2(dz, dx)) + 0.02; /* samakan ke mesh bukit (+0.02) */
    if (hb > h) h = hb;
  }
  /* gundukan mercusuar (Fase 4): teras tunggal 2.5 + landai */
  var mx = x - MERCU.x, mz = z - MERCU.z;
  var md = Math.sqrt(mx * mx + mz * mz);
  if (md < 8){
    var hm = tinggiMercu(md, Math.atan2(mz, mx)) + 0.02; /* samakan ke mesh (+0.02) */
    if (hm > h) h = hm;
  }
  /* dek dermaga: landai 0 -> 0.5 pada x -57..-60, rata 0.5 sesudahnya */
  if (x < -56.4 && Math.abs(z) < 3.4){
    var hd = (-57 - x) / 3 * 0.5;
    hd = clamp(hd, 0, 0.5);
    if (hd > h) h = hd;
  }
  /* dek dermaga danau (Fase 5): landai 0 -> 0.5 pada x -157..-160 */
  if (z > -21.8 && z < -18.2 && x < -156.6 && x > -174){
    var hdan = clamp((-157 - x) / 3, 0, 1) * 0.5;
    if (hdan > h) h = hdan;
  }
  /* dek jembatan Pulau Kecil (Fase 5) */
  var jbi = jembatanInfo(x, z);
  if (jbi.d < 1.7){
    var hjb = tinggiDekJembatan(jbi.t);
    if (hjb > h) h = hjb;
  }
  /* Gunung Awan (Fase 5) */
  var gx = x - GUNUNG.x, gz = z - GUNUNG.z;
  var gd = Math.sqrt(gx * gx + gz * gz);
  if (gd < 58){
    var hg = tinggiGunung(gd, Math.atan2(gz, gx)) + 0.02;
    if (hg > h) h = hg;
  }
  return h;
}
/* area yang sah diinjak: pulau utama, lobus tenggara, dek dermaga,
   plus Fase 4: boulevard City Walk, lobus Distrik Utara, Pantai Selatan,
   gundukan mercusuar */
function dalamArea(x, z){
  if (Math.hypot(x, z) <= 57.2) return true;
  if (Math.hypot(x - 40, z - 40) <= 22.3) return true;
  if (Math.hypot(x - 46, z) <= 23.3) return true;
  if (x <= -56.4 && x >= -80.2 && Math.abs(z) <= 2.9) return true;
  if (Math.abs(x - 3.5) <= 5.4 && z <= -18 && z >= -97) return true;
  if (Math.hypot(x - 3.5, z + 58) <= 31.5) return true; /* lobus City Walk: tanah deretan toko */
  if (Math.hypot(x, z + 100) <= 31.5) return true;
  var ep = (x / 45) * (x / 45) + ((z - 61.5) / 18.5) * ((z - 61.5) / 18.5);
  if (ep <= 1) return true;
  if (Math.hypot(x - MERCU.x, z - MERCU.z) <= 8.3) return true;
  /* ---------- Fase 5: benua ---------- */
  if (jembatanInfo(x, z).d <= 1.5) return true;                 /* jembatan pulau */
  if (Math.hypot(x + 88, z - 98) <= 13.2) return true;          /* Pulau Kecil */
  if (x >= -172.5 && x <= -156.5 && Math.abs(z + 20) <= 1.6) return true; /* dermaga danau */
  /* danau adalah air: veto untuk semua daratan padang di bawah ini.
     AUDIT 2026-11-09 (R4): veto disesuaikan tapak GLB danau baru 46x36
     (elips half 23x18 di (-180,-20); dulu lingkaran r 20,8) */
  var _dl = ((x + 180) / 23) * ((x + 180) / 23) + ((z + 20) / 18) * ((z + 20) / 18);
  if (_dl > 1){
    if (x >= -250 && x <= -71 && z >= -61 && z <= 91) return true;   /* Padang Barat */
    if (x >= -71.5 && x <= -38 && z >= 8 && z <= 80) return true;    /* penghubung selatan */
    if (x >= -71.5 && x <= -44 && z >= -60 && z <= -8) return true; /* penghubung utara */
    if (x >= 60 && x <= 245 && z >= -165 && z <= -15) return true;   /* Hutan Pinus */
    if (x >= 46 && x <= 62 && z >= -42 && z <= -6) return true;      /* jembatan darat timur */
    if (x >= 28 && x <= 80 && z >= -138 && z <= -92) return true;    /* jembatan darat utara */
    if (x >= -45 && x <= 45 && z >= -205 && z <= -128) return true;  /* penghubung gunung */
    if (Math.hypot(x - GUNUNG.x, z - GUNUNG.z) <= 56.5) return true; /* cakram Gunung Awan */
  }
  /* AUDIT 2026-11-09 (TB2): daratan selatan rekreasi x -85..85, z 135..225 */
  if (x >= -85 && x <= 85 && z >= 135 && z <= 225) return true;
  return false;
}
/* langkah sah = di dalam area DAN beda tinggi dari posisi sekarang kecil
   (sisi teras yang curam otomatis terblokir, landai lolos) */
function langkahSah(x, z){
  if (!dalamArea(x, z)) return false;
  return Math.abs(tinggiTanah(x, z) - tinggiTanah(pemain.x, pemain.z)) <= 0.8;
}

