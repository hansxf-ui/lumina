/* ---------- F8 TES — ROTI & KOPI model generate (GLB bertekstur) ----------
   Pola aman: toko rakitan tangan tetap dibangun & tampil seperti biasa.
   Model GLB dimuat async; HANYA bila muat sukses toko lama disembunyikan
   dan model GLB tampil di plot yang sama. Bila loader tidak ada / muat
   gagal / timeout, tidak ada perubahan apa pun — game persis seperti F7.
   Collider tidak disentuh (tetap r 4.2 dari buatTokoRoti). */
/* Anisotropy untuk tekstur GLB (perbaikan burik, menara 2-6):
   three.js memberi tekstur GLB anisotropy=1 (default) — fasad yang dilihat
   miring/dari bawah jadi lumer karena mipmap. Tekstur kanvas sudah pakai
   anisotropy 4; semua model GLB gedung disamakan lewat helper ini. */
/* Timeout loader gedung 25 -> 180 dtk (regresi 21:45): total GLB gedung
   161 MB dimuat serentak dari cache dingin — di koneksi HP timer 25 dtk
   habis sebelum berkas besar selesai, callback pulang awal, gedung kode
   tetap tampil (toko ikut kena karena ikut antre bandwidth). 180 dtk
   menutup sampai ~7 Mbps; gagal beneran (404/parse) tetap langsung
   fallback lewat onError, jadi timeout ini hanya untuk muat lambat. */
function anisotropiGLB(model){
  var maks = Math.min(4, renderer.capabilities.getMaxAnisotropy());
  model.traverse(function(o){
    if (!o.isMesh || !o.material) return;
    var mats = Array.isArray(o.material) ? o.material : [o.material];
    mats.forEach(function(m){
      ['map', 'normalMap', 'roughnessMap', 'metalnessMap', 'emissiveMap', 'aoMap'].forEach(function(k){
        if (m[k]){ m[k].anisotropy = maks; m[k].needsUpdate = true; }
      });
    });
  });
}

