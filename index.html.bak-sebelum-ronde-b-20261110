  renderer.render(scene, camera);
}
/* ===== PERF R2: GABUNG MESH STATIS =====
   Draw call 200-300/frame di HP adalah biang frame 45-77 ms (diukur
   readout 18:31). Koreksi R3: box/cylinder 1 MATERIAL = 1 call (grup
   geometri hanya meledak bila materialnya ARRAY — itu urusan R3).
   R2 ini menang dari jumlah mesh: puluhan lampu/kios digabung per
   material jadi segelintir mesh, transform dunia di-bake. AMAN karena yang digabung hanya mesh
   primitif statis; yang TIDAK disentuh: grup swap toko/menara (nama
   diawali TOKO_, ROTI_KOPI_LAMA, MENARA_U), bangku (bangkuSwapList, swap GLB
   masih jalan), perahu (perahuList, bergerak), sinar mercu (berputar),
   mesh GLB/skinned/instanced/multi-material, mesh tak terlihat, dan
   geometri ber-morph/warna. Collider = data penabrak (bukan mesh), jadi
   tidak terpengaruh. Material yang dibagi (mis. kiosHangatMat) tetap
   hidup karena merge per objek material, bukan per nama. */
var _TIPE_PRIMITIF = { BoxGeometry:1, CylinderGeometry:1, SphereGeometry:1, PlaneGeometry:1, ConeGeometry:1, CircleGeometry:1, OctahedronGeometry:1, TorusGeometry:1, TetrahedronGeometry:1, DodecahedronGeometry:1, IcosahedronGeometry:1, RingGeometry:1 };
function _bolehGabung(o){
  if (!o.isMesh || o.isSkinnedMesh || o.isInstancedMesh) return false;
  if (Array.isArray(o.material)) return false;
  var g = o.geometry;
  if (!g || !_TIPE_PRIMITIF[g.type]) return false;
  if (!g.attributes.position || !g.attributes.normal || !g.attributes.uv) return false;
  if (g.morphAttributes && Object.keys(g.morphAttributes).length) return false;
  if (g.attributes.color) return false;
  var p = o;
  while (p){
    if (p.visible === false) return false;
    if (p.userData && p.userData.janganGabung) return false;
    if (p.name && (p.name.indexOf('TOKO_') === 0 || p.name === 'ROTI_KOPI_LAMA' || p.name.indexOf('MENARA_U') === 0)) return false;
    p = p.parent;
