    r.av.grup.rotation.y = sudutLerp(r.av.grup.rotation.y, r.try_, k);
    var rax = (r._ax == null) ? r.av.grup.position.x : r._ax;
    var raz = (r._az == null) ? r.av.grup.position.z : r._az;
    var jauhR = Math.hypot(r.av.grup.position.x - rax, r.av.grup.position.z - raz);
    animasiAvatar(r.av, dt, detik, dt > 0 ? jauhR / dt : 0, (r.y || 0) > 0.001);
    if (r.av.mixer) r.av.mixer.update(dt);
