    poseLompat(r.av, dt, { ancang: 0, serap: 0, y: yR, vy: r._vyH });
    terapkanIdleMixer(r.av, dt, yR > 0.001);
    r._ax = r.av.grup.position.x;
    r._az = r.av.grup.position.z;
  });
