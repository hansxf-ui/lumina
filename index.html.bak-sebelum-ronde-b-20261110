  scene.background.copy(a.sky).lerp(b.sky, t);
  scene.fog.color.copy(scene.background);
  if (typeof laut !== 'undefined' && laut.material && laut.material.color) laut.material.color.copy(a.sea).lerp(b.sea, t);
  hemi.intensity = lerp(a.hemiI, b.hemiI, t) * 1.25 + 0.02;   /* F7: sisi bayangan tidak mati */
  hemi.color.copy(a.sky).lerp(b.sky, t).lerp(_ca.set(0xffffff), 0.35);
  langit.night = lerp(a.night, b.night, t);
  if (typeof airLaut !== 'undefined') airLaut.setSky(scene.background, langit.night);   /* air ikut langit + siang/malam */
  if (typeof daftarAirShader !== 'undefined') daftarAirShader.forEach(function(w){ w.setSky(scene.background, langit.night); });
  var sunI = lerp(a.sunI, b.sunI, t);
  /* BATCH 4 S3: matahari siang / bulan malam berbagi satu lampu — DULU cabang
     keras night<0,6: posisi meloncat ~188 m dalam 1 frame di senja (h 19,250)
     & fajar (h 5,889), arah bayangan membalik seketika. KINI crossfade:
     kedua posisi+intensitas+warna dihitung tiap frame, dibaur k =
     clamp((night-0,45)/0,30) selama pita senja ~19:00-19:30 & fajar
     ~05:33-06:20 (jam perangkat = jam virtual, jadi pita = puluhan ribu
     frame; langkah maks lampu 188 m -> 0,38 m per 3,6 dtk virtual).
     _ca = warna siang, _cb = warna malam (temp yang sudah ada). */
  var f = clamp((h - 6) / 12.75, 0, 1);
  var el = Math.sin(f * Math.PI);
  var siangX = Math.cos(f*Math.PI) * -90, siangY = el * 85 + 6, siangZ = 42;
  var siangI = Math.max(sunI, el * 0.25);
  _ca.set(0xff9a3c); _cb.set(0xfff4e0); _ca.lerp(_cb, clamp(el*1.6, 0, 1));
  var fm = (((h - 18.75) + 24) % 24) / 11.5;
  var elm = Math.sin(clamp(fm, 0, 1) * Math.PI);
  var malamX = Math.cos(clamp(fm,0,1)*Math.PI) * -80, malamY = elm * 70 + 14, malamZ = -38;
  var malamI = 0.28;
  _cb.set(0xa8c4ff);
  var kCahaya = clamp((langit.night - 0.45) / 0.30, 0, 1);
  matahari.position.set(lerp(siangX, malamX, kCahaya), lerp(siangY, malamY, kCahaya), lerp(siangZ, malamZ, kCahaya));
  matahari.intensity = lerp(siangI, malamI, kCahaya);
  matahari.color.copy(_ca).lerp(_cb, kCahaya);
  if (typeof bintangLangit !== 'undefined') bintangLangit.material.opacity = langit.night * 0.95;
  if (typeof lampuGlow !== 'undefined') lampuGlow.forEach(function(g){
    g.material.opacity = langit.night * 0.85;
    g.visible = g.material.opacity > 0.01;
  });
  if (typeof jamGlow !== 'undefined') jamGlow.forEach(function(g){ g.material.opacity = langit.night * 0.75; });
  if (typeof bahanJendela !== 'undefined') bahanJendela.forEach(function(m){ m.emissiveIntensity = langit.night * 1.35; });
  /* Fase 5: pusat bayangan mengikuti pemain — jangkar bergeser hanya bila
     pemain menjauh > 8 m, dan dijepret ke kelipatan 4 m agar bayangan stabil */
  if (typeof pemain !== 'undefined' && pemain && sudahMasuk && pemain.av){
    var jx = pemain.av.grup.position.x, jz = pemain.av.grup.position.z;
    if (Math.hypot(jx - bayangJangkar.x, jz - bayangJangkar.z) > 8){
      bayangJangkar.x = Math.round(jx / 4) * 4;
      bayangJangkar.z = Math.round(jz / 4) * 4;
    }
  }
  matahari.position.x += bayangJangkar.x;
  matahari.position.z += bayangJangkar.z;
  matahari.target.position.set(bayangJangkar.x, 0, bayangJangkar.z);
  matahari.target.updateMatrixWorld();
}

