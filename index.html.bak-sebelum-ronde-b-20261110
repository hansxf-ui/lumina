var riwayatBuatAvatar = [];
function prosesPesan(st){
  if (!st) return;
  if (st.pergi){
    /* pergi hanya dihormati bila sasaran sudah basi / tidak dikenal —
       remote yang masih segar tidak bisa dibunuh pihak ketiga */
    var korban = remotes.get(st.pergi);
    if (korban && Date.now() - korban.lastSeen <= 4000) return;
    hapusRemote(st.pergi);
    return;
  }
  if (!st.id || st.id === ID) return;
  if (!angkaSah(st.ts) || Math.abs(Date.now() - st.ts) > 15000) return;
  if (!angkaSah(st.x) || !angkaSah(st.z)) return;
  var sx = clamp(st.x, -135, 135), sz = clamp(st.z, -135, 135);
  var sry = angkaSah(st.ry) ? st.ry : 0;
  var sy = angkaSah(st.y) ? clamp(st.y, 0, 4) : 0;
  var r = remotes.get(st.id);
  if (!r){
    var kiniBuat = Date.now();
    riwayatBuatAvatar = riwayatBuatAvatar.filter(function(t){ return kiniBuat - t < 1000; });
    if (remotes.size >= 40 || riwayatBuatAvatar.length >= 10) return;
    riwayatBuatAvatar.push(kiniBuat);
    var idx = (typeof st.warna === 'number' && WARNA[st.warna]) ? st.warna : 0;
    var karR = (st.kar === 'cowok') ? 'cowok' : 'cewek';   /* klien lama tanpa field kar -> cewek */
    r = {
      av: buatAvatarKarakter(karR, WARNA[idx], st.nama || 'Tamu'),
      nama: st.nama || 'Tamu', warna: idx, kar: karR,
      tx: sx, tz: sz, try_: sry, y: sy,
      lastSeen: Date.now(), emoteTs: 0, duduk: !!st.duduk, bot: st.id === 'botlokal'
    };
    if (r.duduk) r.av.setDuduk(true);
    r.av.grup.position.set(r.tx, tinggiTanah(r.tx, r.tz) + (r.duduk ? 0.46 : r.y), r.tz);
    r.av.grup.rotation.y = r.try_;
    scene.add(r.av.grup);
    remotes.set(st.id, r);
    perbaruiHitungan();
  }
  /* identitas (nama & warna) terkunci dari pesan pertama selama entri hidup */
  r.tx = sx; r.tz = sz; r.try_ = sry; r.y = sy;
  r.lastSeen = Date.now();
  if (!!st.duduk !== r.duduk){
    r.duduk = !!st.duduk;
    r.av.setDuduk(r.duduk);
  }
  if (st.emote && EMOTES.indexOf(st.emote) !== -1 && st.emoteTs && st.emoteTs !== r.emoteTs){
    r.emoteTs = st.emoteTs;
    r.av.tampilEmote(st.emote);
  }
}
