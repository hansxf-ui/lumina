    lampionGlowList[i].material.opacity = nf * 0.75;
    lampionGlowList[i].visible = lampionGlowList[i].material.opacity > 0.01;
  }
  for (i = 0; i < kiosGlowList.length; i++){
    kiosGlowList[i].spr.material.opacity = nf * kiosGlowList[i].opMaks;
    kiosGlowList[i].spr.visible = kiosGlowList[i].spr.material.opacity > 0.01;
  }
  for (i = 0; i < kiosHangatMat.length; i++){
    var kh = kiosHangatMat[i];
    kh.mat.emissive.copy(kh.warna).multiplyScalar(nf * kh.kuat);
  }
  senjaGlowList.forEach(function(spr){
    var target = senjaAktif ? 0.5 + 0.25 * Math.sin(detik * 2.2 + spr.userData.fase) : 0;
    spr.material.opacity += (target - spr.material.opacity) * Math.min(1, dt * 5);
    spr.visible = spr.material.opacity > 0.01;
    if (senjaAktif) spr.material.color.setHSL((detik * 0.05 + spr.userData.fase) % 1, 0.85, 0.6);
  });
  perbaruiKembangApi(dt);
}

