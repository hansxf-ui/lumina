/* tekstur paving plaza digambar di canvas: ubin batu abu hangat + nat gelap
   + lingkaran konsentris aksen mengelilingi air mancur */
function buatTeksturPlaza(){
  var S = 1024, cv = document.createElement('canvas');
  cv.width = cv.height = S;
  var x = cv.getContext('2d');
  var C = S/2, skala = S/28; // 28 satuan dunia -> S piksel
  x.fillStyle = '#c8b394'; x.fillRect(0, 0, S, S);
  /* ubin 2x2 satuan dengan variasi warna halus */
  var ubin = 2 * skala, i, j, v;
  for (i=0; i<14; i++){
    for (j=0; j<14; j++){
      v = ((i*7 + j*13) % 5) - 2;
      x.fillStyle = 'rgb(' + (200 + v*4) + ',' + (179 + v*3) + ',' + (148 + v*2) + ')';
      x.fillRect(i*ubin + 1.5, j*ubin + 1.5, ubin - 3, ubin - 3);
    }
  }
  /* garis nat gelap antar ubin */
  x.strokeStyle = 'rgba(94,78,58,0.85)'; x.lineWidth = 3;
  x.beginPath();
  for (i=0; i<=14; i++){
    x.moveTo(i*ubin, 0); x.lineTo(i*ubin, S);
    x.moveTo(0, i*ubin); x.lineTo(S, i*ubin);
  }
  x.stroke();
  /* garis radial halus dari pusat */
  x.strokeStyle = 'rgba(94,78,58,0.35)'; x.lineWidth = 2;
  x.beginPath();
  for (i=0; i<12; i++){
    var a = i * Math.PI/6;
    x.moveTo(C + Math.cos(a)*4.4*skala, C + Math.sin(a)*4.4*skala);
    x.lineTo(C + Math.cos(a)*13.6*skala, C + Math.sin(a)*13.6*skala);
  }
  x.stroke();
  /* lingkaran konsentris aksen di sekeliling air mancur */
  var ring = [
    { r:4.35, w:0.34, c:'#a05238' },
    { r:6.9,  w:0.20, c:'#8f7154' },
    { r:9.4,  w:0.26, c:'#a05238' },
    { r:11.9, w:0.20, c:'#8f7154' },
    { r:13.55, w:0.30, c:'#a05238' }
  ];
  ring.forEach(function(g){
    x.beginPath();
    x.arc(C, C, g.r * skala, 0, Math.PI*2);
    x.strokeStyle = g.c;
    x.lineWidth = g.w * skala;
    x.stroke();
  });
  var t = new THREE.CanvasTexture(cv);
  t.encoding = THREE.sRGBEncoding;
  t.anisotropy = Math.min(4, renderer.capabilities.getMaxAnisotropy());
  return t;
}
