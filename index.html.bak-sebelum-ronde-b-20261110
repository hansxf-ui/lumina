      av.mixer = new THREE.AnimationMixer(model);
      av.aksiJalan = av.mixer.clipAction(klipWalk);
      av.aksiLari = av.mixer.clipAction(klipRun);
      av.aksiJalan.setLoop(THREE.LoopRepeat, Infinity);
      av.aksiLari.setLoop(THREE.LoopRepeat, Infinity);
      av.pakaiMixer = true;
