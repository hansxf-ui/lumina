  perahuList.forEach(function(b){
    b.g.position.y = b.y0 + Math.sin(detik * 0.85 + b.fase) * 0.06;
    b.g.rotation.z = Math.sin(detik * 0.6 + b.fase * 1.7) * 0.05;
    b.g.rotation.x = Math.cos(detik * 0.5 + b.fase) * 0.03;
  });
  awanList.forEach(function(s){
    s.position.x += s.userData.kecepatan * dt;
    if (s.position.x > 330) s.position.x = -330;
    var opAwan = 0.75 - langit.night * 0.55;
    (s.userData.mats || []).forEach(function(mt){ mt.opacity = opAwan; });
  });
  perbaruiF3(dt, detik);
  perbaruiF4(dt, detik);
  perbaruiF5(dt, detik);
  if (botNyala) gerakBot(dt, detik);
  if (sudahMasuk){
    if (dt > 0.05){ perbaruiPemain(dt / 2, detik); perbaruiPemain(dt / 2, detik); }
    else perbaruiPemain(dt, detik);
    cekBangku();
    var pax = (pemain._ax == null) ? pemain.av.grup.position.x : pemain._ax;
    var paz = (pemain._az == null) ? pemain.av.grup.position.z : pemain._az;
    var jauhP = Math.hypot(pemain.av.grup.position.x - pax, pemain.av.grup.position.z - paz);
    var lompatLokal = pemain.y > 0.001 || (pemain.ancang || 0) > 0 || (pemain.serap || 0) > 0;
    animasiAvatar(pemain.av, dt, detik, dt > 0 ? jauhP / dt : 0, lompatLokal);
    /* Jalur A: mixer jalan sesudah pilih klip, sebelum poseLompat
       (poseLompat membaca pose klip saat ini untuk campur mulus);
       pose duduk dicampur sesudah mixer.update supaya tak ditimpa */
    if (pemain.av.mixer) pemain.av.mixer.update(dt);
    terapkanDudukMixer(pemain.av, dt);
    poseLompat(pemain.av, dt, { ancang: pemain.ancang || 0, serap: pemain.serap || 0, y: pemain.y, vy: pemain.vy });
    terapkanIdleMixer(pemain.av, dt, lompatLokal);
    pemain._ax = pemain.av.grup.position.x;
    pemain._az = pemain.av.grup.position.z;
  }
  remotes.forEach(function(r){
    var k = 1 - Math.exp(-dt * 7);
    r.av.grup.position.x += (r.tx - r.av.grup.position.x) * k;
    r.av.grup.position.z += (r.tz - r.av.grup.position.z) * k;
    var ty = tinggiTanah(r.tx, r.tz) + (r.duduk ? 0.46 : (r.y || 0));
