      else if (o.material.map.image.height === 112) o.position.y = modelBaru ? ((kar === 'cowok') ? 2.59 : 2.24) : 2.30;
    }
  });
  av.setDuduk = function(duduk){
    av.duduk = duduk;
    av.tubuh.position.y = duduk ? av.turunDuduk : 0;
    av.tubuh.rotation.x = duduk ? CONDONG_DUDUK : 0;
    if (av.pakaiMixer){
      /* Model baru: pose duduk dicampur per-frame oleh
         terapkanDudukMixer (sesudah mixer.update) — di sini hanya
         matikan klip supaya tak melawan pose. _wDuduk diramp di sana. */
      if (duduk && av.aksiAktif){ av.aksiAktif.fadeOut(0.15); av.aksiAktif = null; }
      return;
    }
    /* jilid 3: duduk-L — paha mendatar + betis menggantung vertikal (rig v2);
       betis dinolkan lagi saat berdiri (animasiAvatar mengambil alih gait) */
    if (av.kakiK) av.kakiK.rotation.x = duduk ? SUDUT_KAKI_DUDUK_L : 0;
    if (av.kakiN) av.kakiN.rotation.x = duduk ? SUDUT_KAKI_DUDUK_L : 0;
    if (av.betisK) av.betisK.rotation.x = duduk ? SUDUT_BETIS_DUDUK : 0;
    if (av.betisN) av.betisN.rotation.x = duduk ? SUDUT_BETIS_DUDUK : 0;
  };
  return av;
}

function buatAvatar(warnaHex, nama, tanpaLabel){
  var grup = new THREE.Group();
  var tubuh = new THREE.Group();
  grup.add(tubuh);
  var isi = new THREE.Group();
  tubuh.add(isi);
  var warna = new THREE.Color(warnaHex);
  var matSweater = new THREE.MeshLambertMaterial({ color: warna.clone() });
  var matKerah = new THREE.MeshLambertMaterial({ color: warna.clone().multiplyScalar(0.7) });
  var matKulit = new THREE.MeshLambertMaterial({ color: 0xffc98f });
  var matRambut = new THREE.MeshLambertMaterial({ color: 0x4e2b0e });
  var matCelana = new THREE.MeshLambertMaterial({ color: 0xe9dec6 });
  var matSepatu = new THREE.MeshLambertMaterial({ color: 0x8a5a33 });

  /* kaki — poros di pinggul supaya bisa berayun/duduk */
  function buatKaki(sisi){
    var poros = new THREE.Group();
    poros.position.set(0.13 * sisi, 0.50, 0);
    var paha = new THREE.Mesh(new THREE.CylinderGeometry(0.082, 0.072, 0.36, 10), matCelana);
    paha.position.y = -0.18;
    poros.add(paha);
    var sepatu = new THREE.Mesh(new THREE.SphereGeometry(0.105, 10, 8), matSepatu);
    sepatu.scale.set(1, 0.55, 1.3);
    sepatu.position.set(0, -0.435, 0.025);
    poros.add(sepatu);
    isi.add(poros);
    return poros;
  }
  var kakiK = buatKaki(-1), kakiN = buatKaki(1);

  /* celana pendek krem */
  var celana = new THREE.Mesh(new THREE.CylinderGeometry(0.295, 0.325, 0.28, 14), matCelana);
  celana.position.y = 0.63;
  isi.add(celana);

  /* sweater warna pilihan pemain + kerah lebih gelap */
  var sweater = new THREE.Mesh(new THREE.CylinderGeometry(0.26, 0.335, 0.54, 14), matSweater);
  sweater.position.y = 1.02;
  isi.add(sweater);
  var kerah = new THREE.Mesh(new THREE.TorusGeometry(0.165, 0.05, 8, 18), matKerah);
  kerah.rotation.x = Math.PI / 2;
  kerah.position.y = 1.29;
  isi.add(kerah);

  /* lengan — poros di bahu */
  function buatLengan(sisi){
    var poros = new THREE.Group();
    poros.position.set(0.315 * sisi, 1.22, 0);
    var lengan = new THREE.Mesh(new THREE.CylinderGeometry(0.072, 0.066, 0.38, 10), matSweater);
    lengan.position.y = -0.17;
    poros.add(lengan);
    var tangan = new THREE.Mesh(new THREE.SphereGeometry(0.08, 10, 8), matKulit);
    tangan.position.y = -0.40;
    poros.add(tangan);
    isi.add(poros);
    return poros;
  }
  var tanganK = buatLengan(-1), tanganN = buatLengan(1);

  /* kepala BESAR chibi */
  var kepala = new THREE.Group();
  kepala.position.y = 1.66;
  isi.add(kepala);
  var bolaKepala = new THREE.Mesh(new THREE.SphereGeometry(0.40, 20, 14), matKulit);
  kepala.add(bolaKepala);
  /* muka: tambalan permukaan bola bertekstur canvas, pas di wajah depan */
  var muka = new THREE.Mesh(
    new THREE.SphereGeometry(0.405, 24, 16, Math.PI / 2 - 0.60, 1.20, Math.PI / 2 - 0.52, 1.04),
    new THREE.MeshLambertMaterial({ map: teksturMuka(), transparent: true })
  );
  kepala.add(muka);
  /* rambut cokelat: topi bola menutup atas-belakang */
  var rambut = new THREE.Mesh(new THREE.SphereGeometry(0.42, 20, 12, 0, Math.PI * 2, 0, Math.PI * 0.50), matRambut);
  rambut.rotation.x = -0.22;
  kepala.add(rambut);
  /* poni depan: tiga gumpalan gepeng di garis rambut */
  [-0.205, 0, 0.205].forEach(function(dx){
    var poni = new THREE.Mesh(new THREE.SphereGeometry(0.105, 10, 8), matRambut);
    poni.scale.set(1.25, 0.55, 0.8);
    poni.position.set(dx, 0.30, 0.27);
    kepala.add(poni);
  });
  /* kunci rambut samping */
  [-1, 1].forEach(function(s){
    var samping = new THREE.Mesh(new THREE.SphereGeometry(0.15, 10, 8), matRambut);
    samping.scale.set(0.5, 1.3, 0.8);
    samping.position.set(0.375 * s, -0.02, 0.01);
    kepala.add(samping);
  });
  /* jambul kecil miring */
  var jambul = new THREE.Mesh(new THREE.ConeGeometry(0.045, 0.17, 8), matRambut);
  jambul.position.set(0.05, 0.44, -0.02);
  jambul.rotation.z = -0.4;
  jambul.rotation.x = 0.12;
  kepala.add(jambul);

  /* label nama — pemain sendiri tidak pakai label (tanpaLabel) */
  var label = null;
  if (!tanpaLabel){
    var cvNama = document.createElement('canvas');
    cvNama.width = 256; cvNama.height = 64;
    var xn = cvNama.getContext('2d');
    rectBulat(xn, 28, 8, 200, 48, 22);
    xn.fillStyle = 'rgba(24,18,34,0.55)'; xn.fill();
    xn.fillStyle = '#ffffff'; xn.font = '700 27px system-ui, sans-serif';
    xn.textAlign = 'center'; xn.textBaseline = 'middle';
    xn.fillText((nama || 'Tamu').slice(0, 16), 128, 34);
    var texNama = new THREE.CanvasTexture(cvNama);
    texNama.encoding = THREE.sRGBEncoding;
    label = new THREE.Sprite(new THREE.SpriteMaterial({ map:texNama, transparent:true, depthWrite:false }));
    label.scale.set(1.85, 0.47, 1);
    label.position.y = 2.38;
    grup.add(label);
  }
  /* gelembung bicara */
  var cvGelembung = document.createElement('canvas');
  cvGelembung.width = 320; cvGelembung.height = 112;
  var texGelembung = new THREE.CanvasTexture(cvGelembung);
  texGelembung.encoding = THREE.sRGBEncoding;
  var gelembung = new THREE.Sprite(new THREE.SpriteMaterial({ map:texGelembung, transparent:true, depthWrite:false }));
  gelembung.scale.set(2.7, 0.95, 1);
  gelembung.position.y = 3.02;
  gelembung.visible = false;
  grup.add(gelembung);
  var timerGelembung = null;
  function tampilEmote(teks){
    var x = cvGelembung.getContext('2d');
    x.clearRect(0, 0, 320, 112);
    rectBulat(x, 8, 6, 304, 82, 24);
    x.fillStyle = 'rgba(255,252,246,0.97)'; x.fill();
    x.beginPath();
    x.moveTo(140, 86); x.lineTo(180, 86); x.lineTo(160, 108); x.closePath();
    x.fillStyle = 'rgba(255,252,246,0.97)'; x.fill();
    x.fillStyle = '#33222e'; x.font = '700 31px system-ui, sans-serif';
    x.textAlign = 'center'; x.textBaseline = 'middle';
    x.fillText(teks, 160, 48);
    texGelembung.needsUpdate = true;
    gelembung.visible = true;
    if (timerGelembung) clearTimeout(timerGelembung);
    timerGelembung = setTimeout(function(){ gelembung.visible = false; }, 3000);
  }
  var av = {
    grup:grup, tubuh:tubuh, isi:isi, kepala:kepala,
    kakiK:kakiK, kakiN:kakiN, tanganK:tanganK, tanganN:tanganN,
    tampilEmote:tampilEmote, setDuduk:setDuduk,
    duduk:false, fase:Math.random() * 10, faseAcak:Math.random() * 10, cepat:0
  };
  function setDuduk(duduk){
    av.duduk = duduk;
    tubuh.position.y = duduk ? -0.33 : 0;
    tubuh.rotation.x = duduk ? CONDONG_DUDUK : 0;
    kakiK.rotation.x = duduk ? SUDUT_KAKI_DUDUK : 0;
    kakiN.rotation.x = duduk ? SUDUT_KAKI_DUDUK : 0;
  }
  return av;
}

/* ---------- tuning gerak (uji HP pemilik 23 Okt: jalan lama 6.2 satuan/dtk
   terasa seperti lari + langkah kaku seperti robot) ----------
   KEC_JALAN: langkah santai untuk karakter 1,35 m; KALI_LARI: tombol Lari.
   PANJANG_SIKLUS: jarak tempuh per satu siklus ayun penuh (2 langkah) —
   fase animasi digerakkan JARAK aktual, jadi irama & kecepatan selalu
   sepasang (jalan pelan = ayun pelan, lari = ayun cepat) tanpa meluncur. */
var KEC_JALAN = 1.5, KALI_LARI = 1.7, PANJANG_SIKLUS = 1.25;

/* animasi chibi: irama dari kecepatan aktual, bob 2x per siklus, ayun torso
   & pelvis amat kecil berlawanan fase, kepala melawan balik dengan jeda —
   semua dihaluskan supaya hidup, bukan metronom robot. Argumen ke-4 kini
   KECEPATAN AKTUAL (satuan/detik), bukan faktor ternormalisasi.
   GAIT LARI (uji pemilik 23 Okt: "mode lari kayak jalan, bedanya speed
   doang"): parameter rLari 0..1 menumpang av.cepat yang sudah dihaluskan,
   jadi pada k<=1 (jalan) SEMUA nilai persis tuning yang diterima pemilik,
   dan menuju k=1.7 berpadu mulus ke karakter lari — langkah kaki lebar
   (±0.72 rad), ayun lengan tegas (±0.58), torso condong ke depan (0.145),
   kepala menunduk tipis, bob 2x lebih kuat dengan puncak diratakan
   (pow 0.6) supaya terasa ada fase melayang. Irama tetap digerakkan jarak
   aktual (anti-skating) persis seperti tuning jalan. */
function animasiAvatar(av, dt, detik, kec, sedangLompat){
  var laju = Math.max(0, kec || 0);
  var target = Math.max(0, Math.min(1.7, laju / KEC_JALAN));
  av.cepat += (target - av.cepat) * Math.min(1, dt * 8);
  var k = av.cepat;                       /* 0 diam · 1 jalan penuh · 1.7 lari */
  var gerak = Math.min(1, k);
  var rLari = Math.max(0, Math.min(1, (k - 1) / 0.7));   /* 0 jalan · 1 lari penuh */
  /* ---------- JALUR A (model cewek baru): klip Mixamo ----------
     ATURAN KONFLIK: avatar bermixer TIDAK BOLEH kena tulis rotasi
     tulang di sini — itu melawan klip. Yang tetap jalan: bob
     av.isi.position.y + napas av.isi.scale.y. Duduk ditangani
     terapkanDudukMixer (sesudah mixer.update); lompat ditangani
     poseLompat (adaptor). */
  if (av.pakaiMixer){
    var napasM = Math.sin(detik * 1.8 + av.faseAcak);
    /* fase bob dikunci ke fase klip supaya bob av.isi seirama dengan
       bob Hips di klip (keduanya 2x per siklus langkah) */
    if (av.aksiAktif) av.fase = (av.aksiAktif.time % av.aksiAktif.getClip().duration) / av.aksiAktif.getClip().duration * Math.PI * 2;
    else av.fase += dt * laju * (Math.PI * 2 / PANJANG_SIKLUS);
    var fM = av.fase;
    var bobJalanM = (Math.abs(Math.cos(fM)) - 0.5) * 0.045;
    var bobLariM = (Math.pow(Math.abs(Math.cos(fM)), 0.6) - 0.58) * 0.088;
    av.isi.position.y = (bobJalanM + (bobLariM - bobJalanM) * rLari) * gerak + napasM * 0.008 * (1 - gerak);
    av.isi.scale.y = 1 + napasM * 0.012 * (1 - gerak);
    /* pilih klip dari kecepatan HALUS (anti-plak-plok remote):
       diam -> tanpa klip (pose bind + napas); jalan -> walk;
       lari (k>1,25 ~ laju>1,9) -> run; duduk/lompat -> tanpa klip */
    var mauM = null;
    if (!av.duduk && !sedangLompat){
      if (k > 1.25) mauM = av.aksiLari;
      else if (k > 0.12) mauM = av.aksiJalan;
    }
    aturAksiMixer(av, mauM, k * KEC_JALAN);
    return;
  }
  av.fase += dt * laju * (Math.PI * 2 / PANJANG_SIKLUS);
  var f = av.fase;
  var s = Math.sin(f) + 0.08 * Math.sin(2 * f);          /* harmonik tipis: ujung ayun tak simetris kaku */
  var sLengan = Math.sin(f - 0.35) + 0.08 * Math.sin(2 * (f - 0.35));  /* lengan tertinggal sedikit dari kaki lawan */
  var napas = Math.sin(detik * 1.8 + av.faseAcak);
  var mikro = 1 + 0.05 * Math.sin(detik * 0.7 + av.faseAcak * 3);      /* variasi amplitudo amat kecil antar-langkah */
  var skalaAmp = 0.75 + 0.35 * Math.min(1.3, k);
  /* amplitudo ayun: ujung jalan = formula tuning lama; ujung lari = basis
     x2.05 (kaki) / x1.65 (lengan); di antaranya interpolasi oleh rLari */
  var ampKakiIni = (av.ampKaki || 0.6) * (skalaAmp * (1 - rLari) + 2.05 * rLari);
  var ampLenganIni = (av.ampLengan || 0.5) * (skalaAmp * (1 - rLari) + 1.65 * rLari);
  /* JAGA (bug 2026-11-08): tulang pemetaan bisa undefined (model tanpa
     tulang itu) — tulis tanpa jaga melempar tiap frame dan membekukan
     render (animate abort sebelum renderer.render). Lewati saja bila
     tak ada; avatar tetap tampil di pose ikat. */
  if (!av.duduk){
    if (av.kakiK) av.kakiK.rotation.x = s * ampKakiIni * mikro * gerak;
    if (av.kakiN) av.kakiN.rotation.x = -s * ampKakiIni * mikro * gerak;
  }
  var dasarLengan = av.duduk ? -0.35 : 0;
  var ampL = ampLenganIni * mikro;
  if (av.tanganK) av.tanganK.rotation.x = dasarLengan - sLengan * ampL * gerak + napas * 0.03 * (1 - gerak);
  if (av.tanganN) av.tanganN.rotation.x = dasarLengan + sLengan * ampL * gerak + napas * 0.03 * (1 - gerak);
  /* ---------- artikulasi rig v2: betis & siku (jilid 3) ----------
     Betis berosilasi tertinggal 0,3 rad dari ayun paha: terlipat paling
     dalam saat kaki yang sama mengayun melewati badan ke depan (denyut
     berpuncak di f=pi untuk kaki kiri / f=0 untuk kaki kanan), menurus
     menjelang injak. Jalan: lipatan amat halus (total <= 0,30 rad).
     Lari: lipatan dalam 0,72 di atas dasar 0,16. Saat duduk blok ini
     diam — pose betis milik setDuduk. */
  if (av.betisK && av.betisN && !av.duduk){
    var denyutK = Math.pow(Math.max(0, -Math.cos(f - 0.3)), 1.3);
    var denyutN = Math.pow(Math.max(0, Math.cos(f - 0.3)), 1.3);
    var ampBetisIni = (0.20 * (1 - rLari) + 0.72 * rLari) * gerak;
    var dasarBetis = (0.03 * (1 - rLari) + 0.16 * rLari) * gerak;
    av.betisK.rotation.x = dasarBetis + denyutK * ampBetisIni;
    av.betisN.rotation.x = dasarBetis + denyutN * ampBetisIni;
  }
  /* siku: menekuk mengikuti keadaan — diam lurus, jalan nyaris lurus
     (-0,15), lari memompa (-1,15 + denyut kecil sefase ayun lengan),
     duduk rileks (-0,30). Dihaluskan per-avatar agar tak menyentak. */
  if (av.sikuK && av.sikuN){
    var tekukSikuTarget;
    if (av.duduk) tekukSikuTarget = 0.30;
    else tekukSikuTarget = (0.10 + 0.05 * gerak) * gerak * (1 - rLari) + 1.15 * rLari;
    if (av._sikuHalus === undefined) av._sikuHalus = tekukSikuTarget;
    av._sikuHalus += (tekukSikuTarget - av._sikuHalus) * Math.min(1, dt * 12);
    var pompaSiku = av.duduk ? 0 : 0.07 * sLengan * rLari;
    av.sikuK.rotation.x = -av._sikuHalus + pompaSiku;
    av.sikuN.rotation.x = -av._sikuHalus - pompaSiku;
  }
  /* bob vertikal 2x per siklus langkah: kurva jalan lama berpadu ke kurva
     lari (amplitudo ±2x, puncak diratakan = kesan memantul/melayang) */
  var bobJalan = (Math.abs(Math.cos(f)) - 0.5) * 0.045;
  var bobLari = (Math.pow(Math.abs(Math.cos(f)), 0.6) - 0.58) * 0.088;
  av.isi.position.y = (bobJalan + (bobLari - bobJalan) * rLari) * gerak + napas * 0.008 * (1 - gerak);
  av.isi.scale.y = 1 + napas * 0.012 * (1 - gerak);
  /* torso & pelvis (model GLB): ayun berlawanan fase amat kecil + condong
     maju — tipis saat jalan (tuning diterima), jelas saat lari */
  if (av.torso){
    av.torso.rotation.y = Math.sin(f) * (0.04 + 0.03 * rLari) * gerak;
    av.torso.rotation.z = Math.sin(f) * 0.018 * gerak;
    av.torso.rotation.x = (0.035 + 0.11 * rLari) * gerak + Math.sin(2 * f) * 0.008 * gerak;
  }
  if (av.pelvis) av.pelvis.rotation.z = Math.sin(f) * (0.02 + 0.012 * rLari) * gerak;
  /* kepala: melawan ayun torso dengan jeda fase — stabil tapi tidak patung;
     saat lari ikut menunduk tipis mengikuti condong torso */
  if (av.kepala){
    av.kepala.rotation.z = Math.sin(f - 0.6) * 0.04 * gerak + napas * 0.015 * (1 - gerak);
    av.kepala.rotation.x = Math.sin(2 * f - 0.6) * 0.025 * gerak + 0.055 * rLari * gerak;
    if (av.torso) av.kepala.rotation.y = -Math.sin(f - 0.3) * 0.05 * gerak;
  }
}

/* ---------- pose lompat berfase (jilid 3) ----------
   Lompat lama: badan naik-turun memakai pose apa pun yang sedang jalan
   (di tempat = kaki lurus diam). Kini pose diikat ke linimasa vertikal
   yang sudah ada (vy0 5,4; gravitasi 15; puncak 0,97 m pada 0,36 dtk;
   udara total 0,72 dtk):
     ancang  — jongkok singkat sebelum tolakan (panggul turun, lutut
               menekuk, torso condong, lengan ke belakang);
     tolakan — kaki menurus, lengan mengayun ke atas;
     puncak  — lutut terlipat (Kaki -0,85 / Betis +1,55), lengan terangkat;
     turun   — kaki menurus ke bawah siap mendarat (Betis +0,22);
     serap   — jongkok penyerap 0,13 dtk sesudah menyentuh tanah.
   Sumber fase smb = {ancang, serap, y, vy}: lokal dari pemain; remote
   hanya membawa y tersiar sehingga ancang/serap-nya kosong dan arah
   vertikalnya ditaksir antar-frame oleh pemanggil. Pose diterapkan
   sebagai campuran di atas keluaran animasiAvatar dengan bobot yang
   menghalus per-avatar — tak pernah menyentak. Hanya avatar GLB rig2;
   avatar tanpa Betis mempertahankan perilaku lompat lama. */
var DUR_ANCANG = 0.13, DUR_SERAP = 0.13;
function poseLompat(av, dt, smb){
  if (!av.betisK || !av.betisN) { av._poseU = null; return; }
  var st = av._poseU;
  if (!st) st = av._poseU = { w:0, kaki:0, betis:0, tang:0, siku:0, torso:0, drop:0 };
  var wT = 0, tKaki = 0, tBetis = 0, tTang = 0, tSiku = 0, tTorso = 0, tDrop = 0;
  if (!av.duduk){
    if (smb.ancang > 0){
      var dalamA = Math.sin(Math.min(1, 1 - smb.ancang / DUR_ANCANG) * Math.PI * 0.5);
      wT = dalamA;
      tKaki = -0.72; tBetis = 1.28; tTang = 0.55; tSiku = -0.25; tTorso = 0.14; tDrop = -0.062;
    } else if (smb.y > 0.001 || smb.vy !== 0){
      wT = Math.min(1, smb.y / 0.08 + 0.3);
      var lipat = Math.pow(Math.max(0, Math.min(1, 1 - Math.abs(smb.vy) / 2.6)), 0.8);
      var turun = smb.vy < 0 ? Math.max(0, Math.min(1, (-smb.vy - 0.3) / 1.7)) : 0;
      tKaki = 0.22 + (-0.85 - 0.22) * lipat;  tKaki += (-0.12 - tKaki) * turun;
      tBetis = 0.06 + (1.55 - 0.06) * lipat;  tBetis += (0.22 - tBetis) * turun;
      tTang = -1.65 + (-1.95 + 1.65) * lipat; tTang += (-0.45 - tTang) * turun;
      tSiku = -0.20 + (-0.38 + 0.20) * lipat; tSiku += (-0.15 - tSiku) * turun;
      tTorso = -0.02 + (0.10 + 0.02) * lipat;  tTorso += (0.05 - tTorso) * turun;
    } else if (smb.serap > 0){
      var dalamS = Math.sin((smb.serap / DUR_SERAP) * Math.PI * 0.5);
      wT = dalamS * (av.cepat > 1.05 ? 0.45 : 0.9);
      tKaki = -0.62; tBetis = 1.10; tTang = 0.35; tSiku = -0.22; tTorso = 0.12; tDrop = -0.050;
    }
  }
  var lajuP = Math.min(1, dt * 16);
  st.w += (wT - st.w) * lajuP;
  st.kaki += (tKaki - st.kaki) * lajuP;
  st.betis += (tBetis - st.betis) * lajuP;
  st.tang += (tTang - st.tang) * lajuP;
  st.siku += (tSiku - st.siku) * lajuP;
  st.torso += (tTorso - st.torso) * lajuP;
  st.drop += (tDrop - st.drop) * lajuP;
  if (st.w < 0.003) { if (wT === 0) st.w = 0; else return; }
  if (st.w <= 0) return;
  var w = Math.min(1, st.w);
  if (av.pakaiMixer){
    /* Model baru: pose lompat TETAP prosedural (berfase ke fisika
       0,72 dtk; klip jump 1,5 dtk tak dipakai) + adaptor ruang-model.
       Sudut di sini ABSOLUT ruang-model: pose lama tersusun relatif
       terhadap parent, jadi betis_abs = kaki + betis_rel,
       tangan_abs = torso + tang, siku_abs = torso + tang + siku_rel
       (di rig Hunyuan semua rotasi tentang sumbu X yang sama sehingga
       dunia menjumlah; adaptor mereproduksi orientasi dunia itu). */
    campurPoseModel(av, {
      kakiK: st.kaki, kakiN: st.kaki,
      betisK: st.kaki + st.betis, betisN: st.kaki + st.betis,
      tanganK: st.torso + st.tang, tanganN: st.torso + st.tang,
      sikuK: st.torso + st.tang + st.siku, sikuN: st.torso + st.tang + st.siku,
      torso: st.torso
    }, w);
    var dasarTubuhYM = av.duduk ? (av.turunDuduk || 0) : 0;
    av.tubuh.position.y = dasarTubuhYM + st.drop * w;
    return;
  }
  av.kakiK.rotation.x = av.kakiK.rotation.x * (1 - w) + st.kaki * w;
  av.kakiN.rotation.x = av.kakiN.rotation.x * (1 - w) + st.kaki * w;
  av.betisK.rotation.x = av.betisK.rotation.x * (1 - w) + st.betis * w;
  av.betisN.rotation.x = av.betisN.rotation.x * (1 - w) + st.betis * w;
  av.tanganK.rotation.x = av.tanganK.rotation.x * (1 - w) + st.tang * w;
  av.tanganN.rotation.x = av.tanganN.rotation.x * (1 - w) + st.tang * w;
  if (av.sikuK && av.sikuN){
    av.sikuK.rotation.x = av.sikuK.rotation.x * (1 - w) + st.siku * w;
    av.sikuN.rotation.x = av.sikuN.rotation.x * (1 - w) + st.siku * w;
  }
  if (av.torso) av.torso.rotation.x = av.torso.rotation.x * (1 - w) + st.torso * w;
  var dasarTubuhY = av.duduk ? (av.turunDuduk || 0) : 0;
  av.tubuh.position.y = dasarTubuhY + st.drop * w;
}

/* ---------- pemain ---------- */
var pemain = {
  x:0, z:15.5, ry:Math.PI, y:0, vy:0, duduk:false, bangku:null, ancang:0, serap:0,
  av: buatAvatarKarakter(karSaya, WARNA[warnaSaya], namaSaya, true)
};
pemain.av.grup.position.set(pemain.x, 0, pemain.z);
pemain.av.grup.rotation.y = pemain.ry;
pemain.av.grup.visible = false;
scene.add(pemain.av.grup);

/* ---------- preload model karakter GLB (sekali di awal; pola aman gedung) ----------
   Sukses -> template disimpan; bila avatar lokal masih prosedural bertanda
   karFallback yang sama, ia ditukar ke GLB di tempat. Gagal -> bendera
   modelKarakterGagal; semua avatar tetap prosedural, errors tetap kosong. */
function gantiAvatarLokal(){
  if (!pemain.av) return;
  var posLama = pemain.av.grup.position.clone();
  var rotLama = pemain.av.grup.rotation.y;
