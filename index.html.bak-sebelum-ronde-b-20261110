/* bebaskan geometri/material/tekstur MILIK satu avatar (tekstur muka
   chibi global yang di-cache BERSAMA tidak ikut dibuang) */
function disposeAvatar(av){
  if (!av || !av.grup) return;
  /* mixer model baru: hentikan aksi supaya animate() tak lagi update
     klon yang sudah dilepas (mixer.update di animate dijaga av.mixer) */
  if (av.mixer){ try { av.mixer.stopAllAction(); } catch(e){} av.mixer = null; av.aksiAktif = null; av.aksiJalan = null; av.aksiLari = null; av.pakaiMixer = false; }
