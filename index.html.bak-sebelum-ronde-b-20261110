/* --- kembang api: pool partikel Points + roket sprite --- */
var FW_MAKS = 900;
var fwPos = new Float32Array(FW_MAKS * 3);
var fwCol = new Float32Array(FW_MAKS * 3);
var fwDasar = new Float32Array(FW_MAKS * 3);
var fwVel = new Float32Array(FW_MAKS * 3);
var fwUmur = new Float32Array(FW_MAKS);
var fwUmurMax = new Float32Array(FW_MAKS);
var fwKepala = 0, fwTimer = 0, fwTrail = 0;
(function(){
  var i;
  for (i = 0; i < FW_MAKS; i++) fwPos[i * 3 + 1] = -999;
})();
var fwGeo = new THREE.BufferGeometry();
fwGeo.setAttribute('position', new THREE.BufferAttribute(fwPos, 3));
fwGeo.setAttribute('color', new THREE.BufferAttribute(fwCol, 3));
var fwTex = (function(){
  var cv = document.createElement('canvas'); cv.width = cv.height = 64;
  var x = cv.getContext('2d');
  var g = x.createRadialGradient(32, 32, 2, 32, 32, 30);
  g.addColorStop(0, 'rgba(255,255,255,1)');
  g.addColorStop(0.35, 'rgba(255,255,255,.85)');
  g.addColorStop(1, 'rgba(255,255,255,0)');
  x.fillStyle = g; x.fillRect(0, 0, 64, 64);
