var jamTiga = new THREE.Clock();
function animate(){
  requestAnimationFrame(animate);
  var dt = Math.min(jamTiga.getDelta(), 0.1);
  var detik = jamTiga.elapsedTime;
  perbaruiResolusiAdaptif(performance.now());   /* F18: resolusi adaptif */
  terapkanLangit();
  if (typeof airLaut !== 'undefined') airLaut.update(detik);   /* air shader: gelombang + pantulan */
  if (typeof daftarAirShader !== 'undefined') daftarAirShader.forEach(function(w){ w.update(detik); });
  if (matAirMancur){
    /* air GLB dihidupkan halus: napas opasitas amat tipis + riak tekstur lambat */
    matAirMancur.opacity = 0.94 + Math.sin(detik * 1.6) * 0.03;
    if (matAirMancur.map) matAirMancur.map.offset.set(Math.sin(detik * 0.11) * 0.02, (detik * 0.008) % 1);
