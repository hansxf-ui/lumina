}
function gabungMeshStatis(){
  _tandaiJanganGabung(sinarMercu);
  bangkuSwapList.forEach(function(e){ _tandaiJanganGabung(e.g); });
  perahuList.forEach(function(r){ _tandaiJanganGabung(r.g); });
  scene.updateMatrixWorld(true);
  var grup = {}, daftar = [];
  scene.traverse(function(o){ if (_bolehGabung(o)) daftar.push(o); });
  daftar.forEach(function(o){
    var kunci = o.material.uuid + '|' + (o.castShadow ? 1 : 0) + '|' + (o.receiveShadow ? 1 : 0);
    (grup[kunci] = grup[kunci] || { mat:o.material, cast:o.castShadow, recv:o.receiveShadow, list:[] }).list.push(o);
  });
  var gabungTotal = 0, hapusTotal = 0;
  Object.keys(grup).forEach(function(kunci){
    var gg = grup[kunci];
    if (gg.list.length < 2) return;
    var pos = [], nor = [], uv = [], idx = [], vb = 0;
    gg.list.forEach(function(o){
      var geo = o.geometry.clone().applyMatrix4(o.matrixWorld);
      var p = geo.attributes.position, n = geo.attributes.normal, u = geo.attributes.uv;
      var i, j;
      for (i = 0; i < p.count; i++){ pos.push(p.getX(i), p.getY(i), p.getZ(i)); nor.push(n.getX(i), n.getY(i), n.getZ(i)); uv.push(u.getX(i), u.getY(i)); }
      if (geo.index){
        var ix = geo.index.array;
        for (j = 0; j < ix.length; j++) idx.push(ix[j] + vb);
      } else {
        for (j = 0; j < p.count; j++) idx.push(vb + j);
      }
      vb += p.count;
    });
    var out = new THREE.BufferGeometry();
    out.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
    out.setAttribute('normal', new THREE.Float32BufferAttribute(nor, 3));
    out.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));
    out.setIndex(idx);
    var mesh = new THREE.Mesh(out, gg.mat);
    mesh.castShadow = gg.cast; mesh.receiveShadow = gg.recv;
    scene.add(mesh);
    gg.list.forEach(function(o){ if (o.parent) o.parent.remove(o); });
    gabungTotal++;
    hapusTotal += gg.list.length;
  });
  if (window.console) console.log('[PERF] gabung mesh: ' + hapusTotal + ' mesh -> ' + gabungTotal + ' mesh gabungan');
}
gabungMeshStatis();
/* ===== PERF R4: BEKU MATRIKS OBJEK STATIS =====
   Tiap frame, renderer menghitung ulang matriks SEMUA objek (~800) walau
   90% tak pernah bergerak — buang-buang CPU di HP lemah. Setelah semua
   builder + gabung jalan, hitung matrixWorld sekali lalu matikan
   matrixAutoUpdate untuk objek statis. AMAN karena: (1) matriks lokal
   objek beku tak pernah berubah; (2) anak dari grup yang bergerak tetap
   dapat matrixWorld benar (three.js merambat force dari induk yang berubah);
   (3) yang bergerak DIKECUALIKAN total: matahari + targetnya (posisi ikut
   busur siang/malam + jangkar bayangan ikut pemain), avatar pemain +
   remote (yang dibuat belakangan pun default true), perahu, sinar mercu,
   awan, airBak, roket + Points kembang api. Objek GLB yang muat belakangan
   (toko, bangku, menara, avatar) default true, tak ikut beku. Perubahan
   material/opacity/visible pada objek beku tetap jalan (bukan matriks). */
function bekuMatriksStatis(){
  var jangan = [];
  function tandai(root){ if (root) root.traverse(function(o){ jangan.push(o); }); }
  if (typeof matahari !== 'undefined' && matahari){ jangan.push(matahari); if (matahari.target) jangan.push(matahari.target); }
  if (typeof pemain !== 'undefined' && pemain.av && pemain.av.grup) tandai(pemain.av.grup);
  if (typeof remotes !== 'undefined') remotes.forEach(function(r){ if (r.av && r.av.grup) tandai(r.av.grup); });
  if (typeof perahuList !== 'undefined') perahuList.forEach(function(b){ tandai(b.g); });
  tandai(sinarMercu);
  if (typeof awanList !== 'undefined') awanList.forEach(function(s){ tandai(s); });
  if (typeof airBak !== 'undefined' && airBak) jangan.push(airBak);
  if (typeof roketPool !== 'undefined') roketPool.forEach(function(r){ jangan.push(r.spr); });
  if (typeof fwPoints !== 'undefined' && fwPoints) jangan.push(fwPoints);
  var setJangan = {};
  jangan.forEach(function(o){ setJangan[o.uuid] = true; });
  scene.updateMatrixWorld(true);
  var beku = 0;
  scene.traverse(function(o){ if (!setJangan[o.uuid]){ o.matrixAutoUpdate = false; beku++; } });
  if (window.console) console.log('[PERF] beku matriks: ' + beku + ' objek statis');
}

/* ---------- LOADING SCREEN + AUTO-LANDSCAPE (24 Okt, perintah Ryan) ----------
   Masalah: pemain masuk lalu melihat gedung/karakter lama bertukar ke GLB
   (pop-in, "pemain shock"). Solusi: gerbang muat -- kartu masuk disembunyikan
   sampai berkas kunci termuat (14 gedung GLB + 2 karakter + semua kios), baru kartu
   masuk tampil sehingga dunia sudah lengkap saat pemain masuk.
   Cara cek: polling scene (grup GLB ditambah ke scene saat sukses) + status
   model karakter -- TIDAK menyentuh loader yang sudah jalan (nol risiko ke
   loader). Pengaman: buka paksa setelah 180 dtk (sama dengan timeout loader
   gedung) supaya gerbang tidak pernah menggantung bila ada berkas gagal.
   Overlay putar-HP: tampil saat perangkat sentuh masih portrait (game ini
   landscape); kunci orientasi dicoba saat tap Masuk (Android Chrome bisa,
   Safari iPhone tidak mengizinkan -- di sana overlay yang memandu). */
(function gerbangMuat(){
  function bukaGate(){
    try {
      if (window.__timerGate) { clearInterval(window.__timerGate); window.__timerGate = null; }
      var lm = document.getElementById('layarMuat');
      if (lm) lm.style.display = 'none';
      /* JAGA (bug 2026-11-08): setTimeout 180 dtk + interval gerbang
         memanggil bukaGate TANPA PEDULI sudahMasuk — kartu masuk muncul
         lagi sendiri sesudah pemain masuk (playtest 20:36-20:37).
         Bila sudah masuk, jangan tampilkan kartu lagi. */
      if (window.sudahMasuk) return;
      var mk = document.getElementById('masuk');
      if (mk) mk.style.display = '';
    } catch (e) {}
  }
  var KUNCI_GEDUNG = ['ROTI_KOPI_GLB','TOKO_KOPI_SENJA_GLB','TOKO_BUKU_KERTAS_GLB','TOKO_ES_KRIM_GLB','TOKO_STUDIO_FOTO_GLB','TOKO_BUNGA_GLB','TOKO_TEH_REMPAH_GLB','TOKO_MAINAN_GLB','MENARA_U0_GLB','MENARA_U1_GLB','MENARA_U2_GLB','MENARA_U3_GLB','MENARA_U4_GLB','MENARA_U5_GLB'];
  function hitungMuat(){
    var n = 0, i, g;
    try {
      for (i = 0; i < KUNCI_GEDUNG.length; i++){ g = scene.getObjectByName(KUNCI_GEDUNG[i]); if (g || gedungGagal[KUNCI_GEDUNG[i]]) n++; } /* FIX audit 2026-10-25 #6: gedung gagal ikut dihitung */
      if (modelKarakter.cewek || modelKarakterGagal.cewek) n++;
      if (modelKarakter.cowok || modelKarakterGagal.cowok) n++;
    } catch (e) { return KUNCI_GEDUNG.length + 2; }
    return n;
  }
  function perbaruiPutar(){
    try {
      var ph = document.getElementById('putarHP'); if (!ph) return;
      var sentuh = (window.matchMedia && matchMedia('(pointer: coarse)').matches) || ('ontouchstart' in window);
      var portrait = window.innerHeight > window.innerWidth;
      ph.style.display = (sentuh && portrait) ? 'flex' : 'none';
    } catch (e) {}
  }
  try {
    if (!NONAKTIFKAN_GERBANG) {
    var lm0 = document.getElementById('layarMuat');
    var mk0 = document.getElementById('masuk');
    if (lm0) lm0.style.display = 'flex';
    if (mk0) mk0.style.display = 'none';
    perbaruiPutar();
    window.addEventListener('resize', perbaruiPutar);
    window.addEventListener('orientationchange', perbaruiPutar);
    setTimeout(bukaGate, 180000);
    window.__timerGate = setInterval(function(){
      try {
        var tk = (typeof totalKiosGLB === 'number') ? totalKiosGLB : 0;
        var sk = (typeof selesaiKiosGLB === 'number') ? selesaiKiosGLB : 0;
        var total = KUNCI_GEDUNG.length + 2 + tk, n = hitungMuat() + sk;
        var bar = document.getElementById('barMuat');
        var tek = document.getElementById('teksMuat');
        if (bar) bar.style.width = Math.round(n / total * 100) + '%';
        if (tek) tek.textContent = 'Memuat kota\u2026 ' + n + '/' + total;
        if (n >= total) bukaGate();
      } catch (e) { bukaGate(); }
    }, 500);
    }
  } catch (e) { bukaGate(); }
  /* kunci landscape begitu fullscreen aktif (percobaan kedua setelah tap Masuk) */
  try {
    document.addEventListener('fullscreenchange', function(){
      try { if (screen.orientation && screen.orientation.lock) { var pl = screen.orientation.lock('landscape'); if (pl && pl.catch) pl.catch(function(){}); } } catch (e2) {}
    });
  } catch (e) {}
})();

