})();
var fwPoints = new THREE.Points(fwGeo, new THREE.PointsMaterial({
  size:1.7, map:fwTex, vertexColors:true, transparent:true,
  depthWrite:false, sizeAttenuation:true, fog:false
}));
fwPoints.frustumCulled = false;
scene.add(fwPoints);
function fwSpawn(x, y, z, vx, vy, vz, warna, umur){
  var i = fwKepala; fwKepala = (fwKepala + 1) % FW_MAKS;
  fwPos[i * 3] = x; fwPos[i * 3 + 1] = y; fwPos[i * 3 + 2] = z;
  fwVel[i * 3] = vx; fwVel[i * 3 + 1] = vy; fwVel[i * 3 + 2] = vz;
  fwDasar[i * 3] = warna.r; fwDasar[i * 3 + 1] = warna.g; fwDasar[i * 3 + 2] = warna.b;
  fwUmur[i] = umur; fwUmurMax[i] = umur;
}
var roketPool = [];
(function(){
  for (var i = 0; i < 6; i++){
    var spr = new THREE.Sprite(new THREE.SpriteMaterial({
      map:fwTex, color:0xffffff, transparent:true, opacity:0.95, depthWrite:false, fog:false
    }));
    spr.scale.set(1.5, 1.5, 1);
    spr.visible = false;
    scene.add(spr);
    roketPool.push({ spr:spr, aktif:false, y:0, vy:0, targetY:0, warna:new THREE.Color(0xffffff) });
  }
})();
function luncurRoket(){
  for (var i = 0; i < roketPool.length; i++){
    var r = roketPool[i];
    if (r.aktif) continue;
    r.aktif = true;
    r.warna.setHSL(Math.random(), 0.9, 0.62);
    r.spr.material.color.copy(r.warna);
    r.spr.position.set(-92 - Math.random() * 26, 0, -14 + Math.random() * 28);
    r.y = 0;
    r.vy = 20 + Math.random() * 5;
    r.targetY = 21 + Math.random() * 8;
    r.spr.visible = true;
    return;
  }
}
function ledakan(r){
  var n = 70 + Math.floor(Math.random() * 25), i;
  var p = r.spr.position;
  for (i = 0; i < n; i++){
    var th = Math.random() * Math.PI * 2;
    var ph = Math.acos(2 * Math.random() - 1);
    var sp = 5 + Math.random() * 5.5;
    fwSpawn(
      p.x, p.y, p.z,
      Math.sin(ph) * Math.cos(th) * sp,
      Math.cos(ph) * sp * 0.92,
      Math.sin(ph) * Math.sin(th) * sp,
      r.warna, 1.3 + Math.random() * 0.6
    );
  }
}
function perbaruiKembangApi(dt){
  var i;
  if (kembangAktif){
    fwTimer -= dt;
    if (fwTimer <= 0){ luncurRoket(); fwTimer = 1.0 + Math.random() * 0.5; }
  }
  fwTrail -= dt;
  roketPool.forEach(function(r){
    if (!r.aktif) return;
    r.y += r.vy * dt;
    r.spr.position.y = r.y;
    if (fwTrail <= 0)
      fwSpawn(r.spr.position.x, r.y - 0.4, r.spr.position.z, 0, -0.6, 0, r.warna, 0.35);
    if (r.y >= r.targetY){
      ledakan(r);
      r.aktif = false;
      r.spr.visible = false;
    }
  });
  if (fwTrail <= 0) fwTrail = 0.03;
  for (i = 0; i < FW_MAKS; i++){
    if (fwUmur[i] <= 0) continue;
    fwUmur[i] -= dt;
    if (fwUmur[i] <= 0){ fwPos[i * 3 + 1] = -999; fwCol[i * 3] = fwCol[i * 3 + 1] = fwCol[i * 3 + 2] = 0; continue; }
    fwVel[i * 3 + 1] -= 3.2 * dt;
    var drag = 1 - 0.55 * dt;
    fwVel[i * 3] *= drag; fwVel[i * 3 + 1] *= drag; fwVel[i * 3 + 2] *= drag;
    fwPos[i * 3] += fwVel[i * 3] * dt;
    fwPos[i * 3 + 1] += fwVel[i * 3 + 1] * dt;
    fwPos[i * 3 + 2] += fwVel[i * 3 + 2] * dt;
    var f = fwUmur[i] / fwUmurMax[i];
    fwCol[i * 3] = fwDasar[i * 3] * f;
    fwCol[i * 3 + 1] = fwDasar[i * 3 + 1] * f;
    fwCol[i * 3 + 2] = fwDasar[i * 3 + 2] * f;
  }
  fwGeo.attributes.position.needsUpdate = true;
  fwGeo.attributes.color.needsUpdate = true;
}

