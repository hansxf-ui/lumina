  if (modelBaru){
    av.kepala = cariNodeGLB(model, 'mixamorig:Head');
    av.torso = cariNodeGLB(model, 'mixamorig:Spine2');
    av.pelvis = cariNodeGLB(model, 'mixamorig:Hips');
    av.kakiK = cariNodeGLB(model, 'mixamorig:LeftUpLeg');
    av.kakiN = cariNodeGLB(model, 'mixamorig:RightUpLeg');
    av.tanganK = cariNodeGLB(model, 'mixamorig:LeftArm');
    av.tanganN = cariNodeGLB(model, 'mixamorig:RightArm');
    av.betisK = cariNodeGLB(model, 'mixamorig:LeftLeg');
    av.betisN = cariNodeGLB(model, 'mixamorig:RightLeg');
    av.sikuK = cariNodeGLB(model, 'mixamorig:LeftForeArm');
    av.sikuN = cariNodeGLB(model, 'mixamorig:RightForeArm');
  } else {
    av.kepala = model.getObjectByName('Kepala');
    av.torso = model.getObjectByName('Torso');     /* ayun torso anti-robot di animasiAvatar */
    av.pelvis = model.getObjectByName('Pelvis');
    av.kakiK = model.getObjectByName('KakiKi');
    av.kakiN = model.getObjectByName('KakiKa');
    av.tanganK = model.getObjectByName('LenganKi');
    av.tanganN = model.getObjectByName('LenganKa');
