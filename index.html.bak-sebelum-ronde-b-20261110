    return;
  }
  setTitik('kuning', false);
  perbaruiHitungan();
  var url = BROKERS[brokerIdx];
  try {
    klien = mqtt.connect(url, {
      clientId: 'lumina-' + ID + '-' + Math.random().toString(36).slice(2, 6),
      reconnectPeriod: 4000,
      connectTimeout: 8000,
      will: { topic: TOPIK, payload: JSON.stringify({ pergi: ID }), qos: 0, retain: false }
    });
  } catch(e){
    setTitik('merah', true);
    $('teksOnline').textContent = 'luring — gagal menyambung';
    return;
  }
  var klienIni = klien;
  var timerGagal = setTimeout(function(){
    if (!terhubung && brokerIdx < BROKERS.length - 1 && klien === klienIni){
      brokerIdx++;
      try { klienIni.end(true); } catch(e){}
      sambungMQTT();
