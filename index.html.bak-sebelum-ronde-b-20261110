   PERGERAKAN & KAMERA
   ========================================================= */
function perbaruiPemain(dt, detik){
  var ix = modeFoto ? 0 : joyX, iz = modeFoto ? 0 : joyY;
  if (!modeFoto){
    if (keys['KeyA'] || keys['ArrowLeft']) ix -= 1;
    if (keys['KeyD'] || keys['ArrowRight']) ix += 1;
    if (keys['KeyW'] || keys['ArrowUp']) iz -= 1;
    if (keys['KeyS'] || keys['ArrowDown']) iz += 1;
  }
  var fx = -Math.sin(camYaw), fz = -Math.cos(camYaw);
  var rx = -fz, rz = fx;
  var mx = fx * (-iz) + rx * ix;
  var mz = fz * (-iz) + rz * ix;
  var len = Math.hypot(mx, mz);
  var bergerak = len > 0.14;
  if (bergerak && pemain.duduk){
    pemain.duduk = false; pemain.bangku = null;
    pemain.av.setDuduk(false);
    tandaiKotor();
  }
  if (bergerak && !pemain.duduk){
    mx /= Math.max(1, len); mz /= Math.max(1, len);
    var sp = KEC_JALAN * (lariAktif ? KALI_LARI : 1) * Math.min(1, len);
    var nx = pemain.x + mx * sp * dt;
    var nz = pemain.z + mz * sp * dt;
    if (langkahSah(nx, nz)){ pemain.x = nx; pemain.z = nz; }
    else if (langkahSah(nx, pemain.z)) pemain.x = nx;
    else if (langkahSah(pemain.x, nz)) pemain.z = nz;
    var pxAman = pemain.x, pzAman = pemain.z;
    dorongPemainSemua(pemain);   /* TUGAS 4: lingkaran (kecuali tanpaPemain) + OBB, iterasi s.d. konvergen */
    /* jangan sampai dorongan penabrak melempar pemain keluar area jalan */
    if (!dalamArea(pemain.x, pemain.z)){ pemain.x = pxAman; pemain.z = pzAman; }
    var targetRy = Math.atan2(mx, mz);
    var ryLama = pemain.ry;
    pemain.ry = sudutLerp(pemain.ry, targetRy, 1 - Math.exp(-dt * 12));
    if (Math.abs(pemain.x - (perbaruiPemain._px || 0)) > 0.001 ||
        Math.abs(pemain.z - (perbaruiPemain._pz || 0)) > 0.001 ||
        Math.abs(ryLama - pemain.ry) > 0.002) tandaiKotor();
    perbaruiPemain._px = pemain.x;
    perbaruiPemain._pz = pemain.z;
    /* bob badan kini SEPENUHNYA dari animasiAvatar (berbasis fase langkah);
       bob jam-dinding detik*10 yang lama dibuang — ia metronom tetap yang
       menggandakan bob fase dan membuat gerak terasa seperti robot. */
  } else {
    pemain.av.tubuh.position.y = pemain.duduk ? (pemain.av.turunDuduk !== undefined ? pemain.av.turunDuduk : -0.33) : 0;
    pemain.av.tubuh.rotation.z = 0;
  }
  /* lompat: ancang -> tolakan -> udara -> serap darat (pose di poseLompat) */
  if (pemain.ancang > 0 && !pemain.duduk){
    pemain.ancang -= dt;
    if (pemain.ancang <= 0){ pemain.ancang = 0; pemain.vy = 5.4; }
  }
  if (pemain.y > 0 || pemain.vy !== 0){
    pemain.y += pemain.vy * dt;
    pemain.vy -= 15 * dt;
    if (pemain.y <= 0){ pemain.y = 0; pemain.vy = 0; pemain.serap = DUR_SERAP; }
  } else if (pemain.serap > 0){
    pemain.serap = Math.max(0, pemain.serap - dt);
  }
  var dasarY = tinggiTanah(pemain.x, pemain.z);
  pemain.av.grup.position.set(pemain.x, dasarY + (pemain.duduk ? 0.46 : pemain.y), pemain.z);
  pemain.av.grup.rotation.y = pemain.ry;
}
var camPos = new THREE.Vector3(0, 6, 20);
var camTarget = new THREE.Vector3();
var camJarak = 8.4;
var camJarakEfektif = 8.4;   /* TUGAS 3 (2026-11-10): jarak kamera efektif sesudah dolly-in
   sadar-garis-pandang; dilembutkan (masuk cepat 8/detik, keluar lambat 2/detik).
   Minimum 2,0 m — tidak menempel ke kepala pemain. */
var modeFoto = false;
/* TUGAS 4 (2026-11-10): dorong PEMAIN keluar dari tapak nyata (OBB
   ZONA_LARANG_PEMAIN) + margin 1,5 m dari muka dinding. Beda dengan
   dorongKeluarTapak (kamera): tanpa cek maxY (pemain selalu di tanah),
   tanpa pilihan sisi sadar-pemain (sisi penetrasi terkecil sudah benar
   untuk mendorong pemain KELUAR), margin 1,5 m (bukan 0,3 m — target
   pemain tidak menempel dinding; 1,0 m menyisakan 1/180 LOS terhalang di (b),
   1,5 m membersihkannya). v = objek {x, z} (biasanya pemain).
   Mengembalikan true bila ada dorongan. */
function dorongPemainKeluarTapak(v){
  var terdorong = false;
  for (var i = 0; i < ZONA_LARANG_PEMAIN.length; i++){
    var o = ZONA_LARANG_PEMAIN[i];
    var dx = v.x - o[0], dz = v.z - o[1];
    var c = Math.cos(o[4]), s = Math.sin(o[4]);
    var lx = dx * c - dz * s, lz = dx * s + dz * c;
    var hx = o[2] + 1.5, hz = o[3] + 1.5;
    if (Math.abs(lx) <= hx && Math.abs(lz) <= hz){
      if (hx - Math.abs(lx) < hz - Math.abs(lz)) lx = (lx >= 0 ? 1 : -1) * hx;
      else lz = (lz >= 0 ? 1 : -1) * hz;
      v.x = o[0] + lx * c + lz * s;
      v.z = o[1] - lx * s + lz * c;
      terdorong = true;
    }
  }
  return terdorong;
}
/* TUGAS 4 (2026-11-10): dorong pemain keluar dari SEMUA penabrak — lingkaran
   (kecuali yang bertanda tanpaPemain) + OBB ZONA_LARANG_PEMAIN. Dipanggil
   perbaruiPemain sesudah langkah. Iterasi maks 3 pass (lingkaran → OBB)
   sampai konvergen; kedua dorongan sama-sama mengarah keluar gedung jadi
   tidak berosilasi. v = objek {x, z} (biasanya pemain). */
function dorongPemainSemua(v){
  var pass, ada;
  for (pass = 0; pass < 3; pass++){
    ada = false;
    penabrak.forEach(function(t){
      if (t.tanpaPemain) return;
      var dx = v.x - t.x, dz = v.z - t.z;
      var d2 = dx*dx + dz*dz, rr = t.r + 0.55;
      if (d2 < rr*rr){
        /* G04 (2026-11-09): pemain TEPAT di pusat lingkaran (d2~0) dulu TIDAK didorong sama sekali
           (guard d2>0.0001 menghindari bagi-nol) — pemain terjebak di pusat selamanya. Kini
           didorong ke titik batas arah +x (deterministik). Hanya berpengaruh bila pemain
           berada <1 cm dari pusat lingkaran (mustahil sambil jalan; hanya teleport/spawn). */
        if (d2 <= 0.0001){ v.x = t.x + rr; v.z = t.z; }
        else { var d = Math.sqrt(d2); v.x = t.x + dx/d * rr; v.z = t.z + dz/d * rr; }
        ada = true;
      }
    });
    if (dorongPemainKeluarTapak(v)) ada = true;
    if (!ada) break;
  }
}
/* R6-KAMERA (2026-11-09): dorong satu titik (Vector3) keluar dari tapak
   nyata (OBB ZONA_LARANG_KAMERA, pusat visual dari bbox.json) bila titik itu
   berada di dalam tapak DAN di bawah atap bangunan tsb (v.y < maxY).
   KAMERA-MARKA (2026-11-10): tabel dialihkan dari ZONA_LARANG_VEG ke
   ZONA_LARANG_KAMERA (salinan verbatim 23 baris, nilai sama persis);
   logika dorong TIDAK diubah, dan ZONA_LARANG_VEG tidak disentuh
   (replay R6). Keluar lewat sisi OBB terdekat (sumbu lokal), margin
   untuk camTarget dan camera.position — S1 (lingkaran kollider) buta di
   sudut bangunan persegi yang diputar (G09: setengah-diagonal 9,48 m vs
   lingkaran r 5,35) dan buta total untuk G04 yang kollidermu tidak
   menyentuh bangunan visualnya. Mengembalikan true bila ada dorongan. */
function dorongKeluarTapak(v, px, pz){
  var terdorong = false;
  var sadarPemain = (typeof px === 'number' && typeof pz === 'number');
  for (var i = 0; i < ZONA_LARANG_KAMERA.length; i++){
    var o = ZONA_LARANG_KAMERA[i];
    if (v.y >= o[5]) continue;   /* di atas atap: bebas, jangan didorong */
    var dx = v.x - o[0], dz = v.z - o[1];
    var c = Math.cos(o[4]), s = Math.sin(o[4]);
    var lx = dx * c - dz * s, lz = dx * s + dz * c;
    if (Math.abs(lx) <= o[2] + 0.3 && Math.abs(lz) <= o[3] + 0.3){
      if (sadarPemain){
        /* TUGAS 3 (2026-11-10) M1: pilih sisi yang menghadap pemain — dari 4
           kandidat keluar, ambil yang titiknya paling dekat ke pemain (bukan
           sisi terdekat dari titik kamera). Tanpa pemain (orbit layar masuk)
           perilaku lama dipakai: sisi penetrasi terkecil. */
        var hx = o[2] + 0.3, hz = o[3] + 0.3;
        var kand = [[hx, lz], [-hx, lz], [lx, hz], [lx, -hz]];
        var pil = 0, jrakMin = Infinity, k;
        for (k = 0; k < 4; k++){
          var wx = o[0] + kand[k][0] * c + kand[k][1] * s;
          var wz = o[1] - kand[k][0] * s + kand[k][1] * c;
          var dd = (wx - px) * (wx - px) + (wz - pz) * (wz - pz);
          if (dd < jrakMin){ jrakMin = dd; pil = k; }
        }
        lx = kand[pil][0]; lz = kand[pil][1];
      } else {
        if (o[2] + 0.3 - Math.abs(lx) < o[3] + 0.3 - Math.abs(lz)) lx = (lx >= 0 ? 1 : -1) * (o[2] + 0.3);
        else lz = (lz >= 0 ? 1 : -1) * (o[3] + 0.3);
      }
      v.x = o[0] + lx * c + lz * s;
      v.z = o[1] - lx * s + lz * c;
      terdorong = true;
    }
  }
  return terdorong;
}
/* TUGAS 3 (2026-11-10) M2: dolly-in sadar-garis-pandang — raycast dari mata
   pemain ke target kamera terhadap OBB ZONA_LARANG_KAMERA; kembalikan jarak
   bersih maksimum (meter) sepanjang ray; bila tidak ada penghalang, kembalikan
   jarak penuh. OBB yang memuat mata pemain DILEWATI: dorong sadar-pemain sudah
   menaruh kamera di sisi pemain, jadi OBB itu false positive (pemain di strip
   margin di luar dinding; ray-nya tidak memotong dinding). Tinggi atap
   diperhitungkan: ray yang lewat DI ATAS atap tidak terhalang. */
function jarakDollyBersih(px, py, pz, tx, ty, tz){
  var dx = tx - px, dy = ty - py, dz = tz - pz;
  var d = Math.sqrt(dx * dx + dy * dy + dz * dz);
  if (d < 1e-6) return 0;
  var ux = dx / d, uy = dy / d, uz = dz / d;
  var bersih = d;
  for (var i = 0; i < ZONA_LARANG_KAMERA.length; i++){
    var o = ZONA_LARANG_KAMERA[i];
    var ox = px - o[0], oz = pz - o[1];
    var c = Math.cos(o[4]), s = Math.sin(o[4]);
    var lx0 = ox * c - oz * s, lz0 = ox * s + oz * c;
    var lxD = ux * c - uz * s, lzD = ux * s + uz * c;
    var hx = o[2], hz = o[3], maxY = o[5];
    var t0 = 0, t1 = d, ok = true;
    var ps = [[-lxD, lx0 + hx], [lxD, hx - lx0], [-lzD, lz0 + hz], [lzD, hz - lz0]];
    for (var k = 0; k < 4; k++){
      var p = ps[k][0], q = ps[k][1];
      if (Math.abs(p) < 1e-12){ if (q < 0){ ok = false; break; } }
      else {
        var tt = q / p;
        if (p < 0){ if (tt > t1){ ok = false; break; } if (tt > t0) t0 = tt; }
        else { if (tt < t0){ ok = false; break; } if (tt < t1) t1 = tt; }
      }
    }
    if (!ok || t0 > t1) continue;
    if (t0 <= 0) continue;   /* mata di dalam OBB: dilewati */
    if (t0 >= bersih) continue;
    var tA = t0, tB = t1;
    if (uy > 1e-12){ tB = Math.min(tB, (maxY - py) / uy); }
    else if (uy < -1e-12){ tA = Math.max(tA, (maxY - py) / uy); }
    else if (py >= maxY){ continue; }
    if (tA < tB && tA < bersih) bersih = tA;
  }
  return bersih;
}
function perbaruiKamera(dt, detik){
  if (!sudahMasuk){
    var a = detik * 0.05;
    camTarget.set(Math.sin(a) * 17, 6.2, Math.cos(a) * 17);
    dorongKeluarTapak(camTarget);   /* JEMBATAN/G04 (2026-11-09): orbit layar masuk r 17 m menembus badan visual G04 — dorong target keluar tapak OBB (fungsi + tabel sudah ada dari ronde R6-kamera). Bila orbit terlihat melompat-lompat di playtest, baris ini di-revert. */
    camera.position.lerp(camTarget, 1 - Math.exp(-dt * 2));
    camera.lookAt(0, 1.6, 0);
    return;
  }
  var px = pemain.av.grup.position.x, py = pemain.av.grup.position.y, pz = pemain.av.grup.position.z;
  var cp = Math.cos(camPitch), sp = Math.sin(camPitch);
  camTarget.set(
    px + Math.sin(camYaw) * cp * camJarak,
    py + sp * camJarak + 0.6,
    pz + Math.cos(camYaw) * cp * camJarak
  );
  /* BATCH 4 S2: lantai kamera ikut tanah di posisi KAMERA, bukan 0,7 absolut —
     teras bukit 1,8 m/tingkat & Gunung Awan 2,8 m/tingkat dulu menelan kamera
     (pitch min hanya ~0,81 m di atas tanah pemain). Margin 0,7 dipertahankan. */
  var tanahCam = tinggiTanah(camTarget.x, camTarget.z);
  if (camTarget.y < tanahCam + 0.7) camTarget.y = tanahCam + 0.7;
  /* BATCH 4 S1: kamera tidak boleh BERISTIRAHAT di dalam tapak bangunan —
     dorong target keluar lingkaran penabrak (r + 0,3) secara radial, 2 pass
     untuk tapak yang tumpang tindih. Dijamin = posisi diam; sapuan lerp
     saat orbit cepat masih bisa menyenggol sudut sesaat. */
  var passS1, iS1, dxS1, dzS1, dS1, rS1;
  for (passS1 = 0; passS1 < 2; passS1++){
    for (iS1 = 0; iS1 < penabrak.length; iS1++){
      dxS1 = camTarget.x - penabrak[iS1].x; dzS1 = camTarget.z - penabrak[iS1].z;
      dS1 = Math.sqrt(dxS1 * dxS1 + dzS1 * dzS1); rS1 = penabrak[iS1].r + 0.3;
      if (dS1 < rS1){
        if (dS1 < 0.001){ camTarget.x = penabrak[iS1].x + rS1; camTarget.z = penabrak[iS1].z; }
        else { camTarget.x = penabrak[iS1].x + dxS1 / dS1 * rS1; camTarget.z = penabrak[iS1].z + dzS1 / dS1 * rS1; }
      }
    }
  }
  /* R6-KAMERA: keep-out tapak nyata untuk TARGET — S1 di atas tidak
     menutupi sudut bangunan persegi yang diputar; jarak/tinggi/sudut
     default TIDAK diubah, dorongan hanya bila target memang di dalam
     tapak di bawah atap. 2x panggil (cerminan 2 pass S1) untuk tapak
     yang bersebelahan. */
  dorongKeluarTapak(camTarget, px, pz);
  dorongKeluarTapak(camTarget, px, pz);
  /* TUGAS 3 (2026-11-10): dolly-in sadar-garis-pandang — bila ray mata pemain
     -> camTarget terhalang OBB, pendekkan jarak efektif sampai garis bersih
     (M2: sudut bangunan memotong garis pandang padahal kamera sudah di luar
     OBB). Dilembutkan: masuk cepat (8/detik) supaya dinding langsung hilang
     dari pandangan, keluar lambat (2/detik) supaya tidak melompat saat pemain
     menjauh dari dinding. Minimum 2,0 m. Orbit layar masuk TIDAK disentuh. */
  var bidikY3 = py + ((pemain.av && pemain.av.bidikY) || ((pemain.av && pemain.av.modelBaru) ? 1.62 : 1.7));
  var ex3 = camTarget.x - px, ey3 = camTarget.y - bidikY3, ez3 = camTarget.z - pz;
  var d03 = Math.sqrt(ex3 * ex3 + ey3 * ey3 + ez3 * ez3);
  if (d03 > 1e-6){
    var dBersih3 = jarakDollyBersih(px, bidikY3, pz, camTarget.x, camTarget.y, camTarget.z);
    /* Margin 0,3 m hanya bila ADA penghalang (dBersih < d0); bila garis bersih,
       jangan pendekkan apa pun (bug awal: kamera selalu masuk 0,3 m). */
    var dTujuan3 = (dBersih3 < d03) ? Math.min(d03, dBersih3 - 0.3) : d03;
    if (dTujuan3 < 2.0) dTujuan3 = 2.0;
    if (dTujuan3 > d03) dTujuan3 = d03;
    if (camJarakEfektif > camJarak) camJarakEfektif = camJarak;
    var lajuDolly3 = (dTujuan3 < camJarakEfektif) ? 8 : 2;
    camJarakEfektif += (dTujuan3 - camJarakEfektif) * (1 - Math.exp(-dt * lajuDolly3));
    if (camJarakEfektif < 2.0) camJarakEfektif = 2.0;
    if (camJarakEfektif > camJarak) camJarakEfektif = camJarak;
    var skala3 = camJarakEfektif / d03;
    if (skala3 < 1){
      camTarget.x = px + ex3 * skala3;
      camTarget.y = bidikY3 + ey3 * skala3;
      camTarget.z = pz + ez3 * skala3;
      var tanahCam3 = tinggiTanah(camTarget.x, camTarget.z);
      if (camTarget.y < tanahCam3 + 0.7) camTarget.y = tanahCam3 + 0.7;
    }
  }
  camera.position.lerp(camTarget, 1 - Math.exp(-dt * 6));
  /* R6-KAMERA: jepit JUGA posisi hasil lerp — segmen lerp dari posisi lama
     ke target baru bisa memotong sudut bangunan walau kedua ujungnya di
     luar tapak (pengakuan S1 sendiri di komentarnya). Dorongan ini
     hanya mengubah posisi render, bukan target; y tidak diubah sehingga
     lantai tanah +0,7 tetap berlaku. */
  dorongKeluarTapak(camera.position, px, pz);
  camera.lookAt(px, py + ((pemain.av && pemain.av.bidikY) || ((pemain.av && pemain.av.modelBaru) ? 1.62 : 1.7)), pz);   /* bidik per karakter: cewek baru 1,62; cowok baru 1,98; lama/prosedural 1,7 */
}

