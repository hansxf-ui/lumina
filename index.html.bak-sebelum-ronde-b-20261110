(function(){
  var terlarang = penabrak.slice();
  var jadi = 0, coba = 0;
  while (jadi < 30 && coba < 300){
    coba++;
    var a = acakVeg() * Math.PI * 2;
    var r = 23.5 + acakVeg() * 31;
    var px = Math.cos(a) * r, pz = Math.sin(a) * r;
    var nabrak = terlarang.some(function(t){ var dx = px-t.x, dz = pz-t.z; return dx*dx + dz*dz < (t.r + 1.6)*(t.r + 1.6); });
    if (nabrak) continue;
    /* AUDIT 2026-11-09 (A18): zona larangan — slot kios baru (filter kios: r pohon + 2,1 m, pakai 3,2 m aman) + jalan-raya */
    if ([23.5, 28.5, 33.5, 38.5].some(function(sx){ return [-6.8, 6.8].some(function(sz){ return Math.hypot(px - sx, pz - sz) < 3.2; }); })) continue;
    if (Math.abs(px) <= 4 && pz >= -96 && pz <= 195) continue;   /* jalan-raya N-S */
    if (Math.abs(pz) <= 8 && px >= -122 && px <= 54) continue;   /* jalan-raya E-W */
    if (Math.hypot(px - 37, pz - 37) < 20.5) continue; /* jangan tumbuh di Taman Bukit */
    if (px < -13 && Math.abs(pz) < 4.6) continue;     /* jangan tumbuh di jalan ke dermaga */
    if (px > 10.5 && Math.abs(pz) < 10.5) continue;   /* jangan tumbuh di lorong Pasar Malam */
    if (Math.hypot(px - 46, pz) < 25) continue;       /* jangan tumbuh di lobus pasar */
    if (Math.abs(px - 3.5) < 7.5 && pz < -14) continue; /* jangan tumbuh di boulevard City Walk (Fase 4) */
    var epP = (px / 47) * (px / 47) + ((pz - 61.5) / 20) * ((pz - 61.5) / 20);
    if (pz > 40 && epP <= 1) continue;               /* jangan tumbuh di Pantai Selatan (Fase 4) */
    if (Math.hypot(px + 38, pz - 72) < 10.5) continue; /* jangan tumbuh di gundukan mercusuar (Fase 4) */
    /* F14: penempatan & undian acak persis seperti dulu — kini dicatat
       untuk InstancedMesh GLB (bulat → pohon, kerucut → pinus).
       Faktor: puncak lama bulat 3.34×s×reg / GLB 2.90; kerucut 3.55 / 3.20. */
    var s = 0.85 + acakVeg() * 0.55;
    var reg = 0.9 + acakVeg()*0.3;
    var ry = acakVeg() * Math.PI;
    if (diZonaLarangVeg(px, pz)) continue;   /* R6: tapak nyata + jalan/sungai — cek SESUDAH undian s/reg/ry agar aliran acakVeg() kandidat yang ditolak sama dengan yang diterima (5 undian), sehingga pohon yang tetap sama posisinya */
    if (jadi % 3 === 2) catatPinus(px, 0, pz, ry, s * reg * 1.111, 'kota');
    else catatPohon(px, 0, pz, ry, s * reg * 1.153, 'kota');
    jadi++;
  }
})();

