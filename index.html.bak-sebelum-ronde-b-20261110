    if (o.userData && o.userData.bersama) return;   /* aset GLB bersama antar-avatar: tidak ikut dibuang */
    if (o.geometry) o.geometry.dispose();
    if (o.material){
      var mats = Array.isArray(o.material) ? o.material : [o.material];
