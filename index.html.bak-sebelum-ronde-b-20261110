<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>LUMINA — Kota Senja</title>
<style>
  html, body { margin:0; padding:0; height:100%; overflow:hidden; background:#0a0e24; }
  body {
    font-family: ui-rounded, "SF Pro Rounded", "Segoe UI", system-ui, -apple-system, sans-serif;
    color:#fff; -webkit-user-select:none; user-select:none; -webkit-tap-highlight-color:transparent;
  }
  #panggung { position:fixed; inset:0; touch-action:none; }
  #panggung canvas { display:block; }

  /* ---------- bilah atas ---------- */
  #atas {
    position:fixed; top:0; left:0; right:0; z-index:20;
    display:flex; justify-content:space-between; align-items:flex-start;
    padding: calc(10px + env(safe-area-inset-top)) 14px 0 14px;
    pointer-events:none;
  }
  #atasKiri { pointer-events:none; }
  #judulKecil { font-weight:800; font-size:20px; letter-spacing:3px; text-shadow:0 2px 10px rgba(0,0,0,.55); }
  #infoOnline { display:flex; align-items:center; gap:7px; margin-top:3px; font-size:13px; font-weight:600; text-shadow:0 1px 6px rgba(0,0,0,.6); }
  #titik { width:11px; height:11px; border-radius:50%; background:#f5c542; box-shadow:0 0 8px rgba(0,0,0,.4); flex:none; }
  #titik.hijau { background:#3ddc68; } #titik.kuning { background:#f5c542; } #titik.merah { background:#ef4444; }
  #luring { display:none; margin-top:4px; font-size:12px; font-weight:600; color:#ffd9d0; text-shadow:0 1px 6px rgba(0,0,0,.7); }
  .tombolAtas {
    pointer-events:auto; border:1px solid rgba(255,255,255,.28); cursor:pointer;
    background:rgba(26,20,38,.55); color:#fff; font:inherit; font-size:13px; font-weight:700;
    padding:9px 14px; border-radius:999px; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .tombolAtas:active { transform:scale(.96); }
  #atasKanan { display:flex; gap:8px; pointer-events:none; }

  /* ---------- pil & banner acara (Fase 3) ---------- */
  #pilAcara {
    position:fixed; left:50%; transform:translateX(-50%); z-index:20;
    top: calc(98px + env(safe-area-inset-top));
    display:none; white-space:nowrap; max-width:94vw; overflow:hidden; text-overflow:ellipsis;
    background:rgba(26,20,38,.62); border:1px solid rgba(255,255,255,.25);
    color:#ffe9c9; font-size:13px; font-weight:700;
    padding:8px 14px; border-radius:999px; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    pointer-events:none; text-shadow:0 1px 4px rgba(0,0,0,.5);
  }
  #bannerAcara {
    position:fixed; left:50%; top:22vh; z-index:30;
    transform:translate(-50%,-10px) scale(.96); opacity:0; pointer-events:none;
    transition:opacity .35s ease, transform .35s ease;
    background:rgba(26,20,38,.78); border:1px solid rgba(255,217,138,.55);
    color:#ffe9a8; font-size:clamp(16px, 4.6vw, 22px); font-weight:800; text-align:center;
    padding:14px 22px; border-radius:18px; max-width:88vw;
    box-shadow:0 14px 40px rgba(0,0,0,.45); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  #bannerAcara.tampil { opacity:1; transform:translate(-50%,0) scale(1); }

  /* ---------- bar mode foto ---------- */
  #barFoto {
    position:fixed; left:50%; transform:translateX(-50%); z-index:22;
    bottom: calc(14px + env(safe-area-inset-bottom));
    display:none; gap:10px; padding:8px; border-radius:999px;
    background:rgba(26,20,38,.45); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }

  /* ---------- bar emote ---------- */
  #barEmote {
    position:fixed; left:50%; transform:translateX(-50%); z-index:20;
    bottom: calc(10px + env(safe-area-inset-bottom));
    display:flex; gap:8px; padding:8px; border-radius:999px;
    background:rgba(26,20,38,.45); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    max-width:96vw; overflow-x:auto; scrollbar-width:none;
  }
  #barEmote::-webkit-scrollbar { display:none; }
  .emote {
    flex:none; border:none; cursor:pointer; font:inherit; font-size:14px; font-weight:700; color:#3a2430;
    background:rgba(255,251,244,.95); padding:10px 14px; border-radius:999px; min-height:44px;
    box-shadow:0 2px 8px rgba(0,0,0,.25);
  }
  .emote:active { transform:scale(.94); background:#ffe9a8; }

  /* ---------- joystick & tombol aksi ---------- */
  #joy {
    position:fixed; z-index:21; left:18px; bottom: calc(92px + env(safe-area-inset-bottom));
    width:124px; height:124px; border-radius:50%;
    background:rgba(255,255,255,.10); border:2px solid rgba(255,255,255,.30);
    backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); touch-action:none;
  }
  #joyKnob {
    position:absolute; left:50%; top:50%; width:56px; height:56px; border-radius:50%;
    background:rgba(255,251,244,.92); box-shadow:0 4px 14px rgba(0,0,0,.35);
    transform:translate(-50%,-50%); pointer-events:none;
  }
  #aksiKanan {
    position:fixed; z-index:21; right:18px; bottom: calc(92px + env(safe-area-inset-bottom));
    display:flex; flex-direction:column; gap:10px; align-items:flex-end;
  }
  .tombolBulat {
    border:1px solid rgba(255,255,255,.3); cursor:pointer; font:inherit; font-weight:800; color:#fff;
    background:rgba(26,20,38,.6); border-radius:999px; padding:14px 20px; font-size:15px; min-height:52px;
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .tombolBulat:active { transform:scale(.95); }
  #btnDuduk { display:none; background:#e2703a; border-color:#ffb98a; }
  #btnLari.aktif { background:#2e9e5b; border-color:#8fe3ae; }

  /* ---------- minimap (Fase 5) ---------- */
  #minimap {
    position:fixed; z-index:19; right:14px; top: calc(62px + env(safe-area-inset-top));
    width:104px; height:104px; border-radius:50%;
    border:2px solid rgba(255,255,255,.35);
    background:rgba(10,18,38,.72);
    box-shadow:0 6px 18px rgba(0,0,0,.35);
    display:none; pointer-events:none;
  }

  /* ---------- layar masuk (GAYA CLAY GEMBUL — pilihan pemilik 23 Okt) ---------- */
  #masuk {
    position:fixed; inset:0; z-index:50; display:flex; justify-content:center;
    background:transparent; overflow-y:auto;
  }
  #kartuMasuk {
    width:100%; box-sizing:border-box; text-align:center; color:#54301d;
    background:#fff6e9; border:3px solid #6d4330; border-radius:28px;
    padding:26px 22px 24px; box-shadow:0 7px 0 rgba(109,67,48,.9);
  }
  #kartuMasuk h1 { margin:0; font-size:34px; font-weight:800; letter-spacing:.5px; color:#54301d; }
  #kartuMasuk label {
    display:block; width:max-content; text-align:left; font-size:12.5px; font-weight:800;
    margin:18px 0 8px 2px; color:#54301d; background:#bfe8c9;
    border:2.5px solid #6d4330; border-radius:999px; padding:3px 12px;
  }
  #kartuMasuk label[for="nama"] { background:#bfe8c9; }
  #kartuMasuk label:not([for]) { background:#ffc4b2; }
  #nama {
    width:100%; box-sizing:border-box; outline:none; border:3px solid #6d4330; border-radius:999px;
    padding:12px 18px; font:inherit; font-size:17px; font-weight:700; color:#54301d;
    background:#fff; text-align:center;
  }
  #nama:focus { box-shadow:0 3px 0 rgba(109,67,48,.9); }
  #pilKar { display:flex; justify-content:center; gap:12px; margin-top:2px; }
  .pilKarBtn {
    flex:1; display:flex; align-items:center; justify-content:center; gap:9px;
    border:3px solid #6d4330; cursor:pointer; font:inherit; font-size:16.5px; font-weight:800;
    color:#54301d; background:#f7ead6; padding:7px 14px 7px 8px; border-radius:999px;
    box-shadow:0 3px 0 rgba(109,67,48,.9);
  }
  .pilKarBtn img.wajah {
    width:38px; height:38px; flex:none; border-radius:50%; object-fit:cover;
    border:3px solid #6d4330; background:#fdeedd;
  }
  .pilKarBtn:active { transform:translateY(2px); box-shadow:0 1px 0 rgba(109,67,48,.9); }
  .pilKarBtn.pilih { background:#ffb59e; }
  .pilKarBtn.pilih img.wajah { box-shadow:0 0 0 3px #ff7f57; }
  #btnMasuk {
    margin-top:22px; width:100%; border:3px solid #6d4330; cursor:pointer; font:inherit;
    font-size:17.5px; font-weight:800; color:#fff8ec;
    background:#ff8b2d; padding:14px; border-radius:999px;
    box-shadow:0 5px 0 #6d4330;
  }
  #btnMasuk:active { transform:translateY(4px); box-shadow:0 1px 0 #6d4330; }
  @media (max-height:520px) { #kartuMasuk h1 { font-size:28px; } #kartuMasuk { padding:20px 18px; } }
  /* HUD ditahan selama layar masuk tampil (overlay kini transparan;
     tanpa aturan ini HUD terlihat dobel di belakang kartu) */
  body:has(#masuk:not([style*="display: none"])) #atas,
  body:has(#masuk:not([style*="display: none"])) #joy,
  body:has(#masuk:not([style*="display: none"])) #aksiKanan,
  body:has(#masuk:not([style*="display: none"])) #barEmote { display:none; }
  /* kartu kompak di tengah */
  #masuk { align-items:center; padding:0; }
  #kartuMasuk { width:86%; max-width:380px; }

  /* ===== POLES UI (ikon SVG + tombol halus) — tempel di akhir <style> ===== */
  .tombolAtas, .tombolBulat, .emote {
    display:inline-flex; align-items:center; justify-content:center; gap:7px;
    transition:transform .18s cubic-bezier(.34,1.56,.64,1), box-shadow .18s ease,
      background-color .18s ease, filter .18s ease;
  }
  .tombolAtas .ico, .tombolBulat .ico, .emote .ico, #pilAcara .ico, #bannerAcara .ico { flex:none; }
  .tombolAtas .ico { width:18px; height:18px; }
  .tombolBulat .ico { width:20px; height:20px; }
  .tombolBulat { gap:8px; }
  .emote .ico { width:19px; height:19px; }
  .tombolAtas {
    background:linear-gradient(180deg, rgba(52,38,72,.78), rgba(26,20,38,.62));
    box-shadow:0 6px 18px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.22);
  }
  .tombolAtas:active { transform:scale(.93); box-shadow:0 2px 8px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.22); }
  .tombolBulat {
    background:linear-gradient(180deg, rgba(52,38,72,.78), rgba(26,20,38,.62));
    box-shadow:0 6px 18px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.22);
  }
  .tombolBulat:active { transform:scale(.93); box-shadow:0 2px 8px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.22); }
  #btnDuduk { background:linear-gradient(180deg, #f08a4b, #e2703a); border-color:#ffb98a; }
  #btnLari.aktif {
    background:linear-gradient(180deg, #3cb96b, #2e9e5b); border-color:#8fe3ae;
    box-shadow:0 6px 18px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.25);
  }
  @media (hover:hover) {
    .tombolAtas:hover, .tombolBulat:hover { filter:brightness(1.12); }
    .emote:hover { filter:brightness(1.03); }
  }
  .tombolAtas:focus-visible, .tombolBulat:focus-visible, .emote:focus-visible {
    outline:2px solid rgba(255,217,138,.9); outline-offset:2px;
  }
  .emote {
    background:linear-gradient(180deg, #fffdf8, #ffedc9);
    box-shadow:0 3px 10px rgba(0,0,0,.28), inset 0 1px 0 rgba(255,255,255,.9);
  }
  .emote:active { transform:scale(.92); background:#ffe9a8; box-shadow:0 1px 4px rgba(0,0,0,.28); }
  #pilAcara {
    background:linear-gradient(180deg, rgba(52,38,72,.72), rgba(26,20,38,.62));
    box-shadow:0 8px 22px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.18);
  }
  #pilAcara .ico { width:18px; height:18px; vertical-align:-4px; margin-right:7px; }
  #bannerAcara {
    background:linear-gradient(180deg, rgba(56,40,74,.88), rgba(26,20,38,.78));
    box-shadow:0 16px 44px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.15);
  }
  #bannerAcara .ico { width:21px; height:21px; vertical-align:-4px; margin-right:8px; }
  #joy {
    background:radial-gradient(circle at 50% 38%, rgba(255,255,255,.20), rgba(255,255,255,.07) 70%);
    box-shadow:0 8px 22px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.25), inset 0 0 0 1px rgba(255,255,255,.12);
  }
  #joyKnob {
    background:radial-gradient(circle at 50% 32%, #fffdf8, #ffe9c4 78%);
    box-shadow:0 5px 16px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.95), inset 0 0 0 1px rgba(255,255,255,.35);
  }
  #minimap {
    border:3px solid rgba(255,255,255,.55);
    box-shadow:0 8px 22px rgba(0,0,0,.45), 0 0 0 4px rgba(255,255,255,.08);
  }
  #infoOnline .ico { width:15px; height:15px; opacity:.9; }
  #luring .ico { width:14px; height:14px; vertical-align:-2px; margin-left:2px; }
  /* animasi ikon putar-HP: goyang portrait -> landscape */
  #putarHP .hpPutar { animation:putarGoyang 1.8s ease-in-out infinite; }
  @keyframes putarGoyang { 0%,100% { transform:rotate(0deg); } 50% { transform:rotate(90deg); } }
</style>
</head>
<body>

<div id="panggung"></div>

<div id="atas">
  <div id="atasKiri">
    <div id="judulKecil">LUMINA</div>
    <div id="infoOnline"><span id="titik" class="kuning"></span><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c.6-3.2 2.9-5 5.5-5s4.9 1.8 5.5 5"/><circle cx="17.5" cy="9" r="2.4"/><path d="M15.5 14.2c2.4.3 4.2 1.9 4.8 4.8"/></svg><span id="teksOnline">menyambung…</span></div>
    <div id="luring">Mode luring — tetap bisa jalan-jalan sendiri <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg></div>
  </div>
  <div id="atasKanan">
    <button class="tombolAtas" id="btnFoto"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="4"/><path d="M8 7l1.2-2.2A2 2 0 0 1 11 3.8h2a2 2 0 0 1 1.8 1L16 7"/><circle cx="12" cy="13.5" r="3.6"/></svg><span>Foto</span></button>
    <button class="tombolAtas" id="btnBayangan"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="3.4"/><path d="M12 3.5v1.4M4.5 9H6M18 9h1.5M7 4.8l1 1M17 4.8l-1 1"/><ellipse cx="12" cy="18.5" rx="6.5" ry="1.8" fill="currentColor" stroke="none" opacity=".55"/></svg><span id="teksBayangan">Bayangan: Nyala</span></button>
  </div>
</div>

<canvas id="minimap" width="208" height="208"></canvas>

<div id="pilAcara"></div>
<div id="bannerAcara"></div>

<div id="barFoto">
  <button class="emote" id="btnJepret"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="4"/><path d="M8 7l1.2-2.2A2 2 0 0 1 11 3.8h2a2 2 0 0 1 1.8 1L16 7"/><circle cx="12" cy="13.5" r="3.6"/><circle cx="12" cy="13.5" r="1.3" fill="currentColor" stroke="none"/></svg><span>Jepret</span></button>
  <button class="emote" id="btnKeluarFoto"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg><span>Keluar</span></button>
</div>

<div id="joy"><div id="joyKnob"></div></div>

<div id="aksiKanan">
  <button class="tombolBulat" id="btnDuduk"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3v10M17 3v10M4.5 13h15M7 13v6M17 13v6"/></svg><span id="teksDuduk">Duduk</span></button>
  <button class="tombolBulat" id="btnLompat"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20V5"/><path d="M5.5 11.5 12 5l6.5 6.5"/><path d="M4 20.5h16" opacity=".55"/></svg><span>Lompat</span></button>
  <button class="tombolBulat" id="btnLari"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="16.5" cy="4.8" r="2.1"/><path d="M13.5 8.5 11 13l3.5 3.5"/><path d="M11 10.5 7.5 8.5M11 10.5l4-1.5"/><path d="M11 13 7 19M11 13l4.5 5"/></svg><span>Lari</span></button>
</div>

<div id="barEmote"></div>

<div id="layarMuat" style="display:none;position:fixed;inset:0;z-index:9998;background:#1c1430;flex-direction:column;align-items:center;justify-content:center;gap:14px;color:#fff6e9;text-align:center;padding:24px;box-sizing:border-box;">
  <div style="font-size:30px;font-weight:800;letter-spacing:.5px;">Lumina</div>
  <div style="width:min(280px,80vw);height:12px;border-radius:8px;background:rgba(255,255,255,.18);overflow:hidden;"><div id="barMuat" style="height:100%;width:0%;background:#ffb347;border-radius:8px;"></div></div>
  <div id="teksMuat" style="font-size:15px;opacity:.9;">Memuat kota…</div>
  <div style="font-size:13px;opacity:.6;">Sebentar ya — kota dimuat lengkap dulu biar nggak ada yang berubah-ubah pas main.</div>
</div>
<div id="putarHP" style="display:none;position:fixed;inset:0;z-index:9999;background:#1c1430;color:#fff6e9;flex-direction:column;align-items:center;justify-content:center;gap:16px;text-align:center;padding:24px;box-sizing:border-box;">
  <div class="hpPutar" style="width:56px;height:96px;border:3px solid #fff6e9;border-radius:12px;position:relative;flex:none;"><div style="position:absolute;left:50%;bottom:8px;transform:translateX(-50%);width:22px;height:3px;border-radius:2px;background:#fff6e9;"></div></div>
  <div style="font-size:20px;font-weight:800;">Putar HP kamu ke landscape</div>
  <div style="font-size:14px;opacity:.75;max-width:280px;">Lumina paling enak dimainkan horizontal.</div>
</div>
<div id="masuk">
  <div id="kartuMasuk">
    <h1>Lumina</h1>
    <label for="nama">Nama tamu kamu</label>
    <input id="nama" maxlength="16" autocomplete="off" placeholder="namamu…">
    <label>Pilih karakter</label>
    <div id="pilKar">
      <button type="button" class="pilKarBtn" data-kar="cewek"><img class="wajah" src="ikon-cewek.png" alt="">Cewek</button>
      <button type="button" class="pilKarBtn" data-kar="cowok"><img class="wajah" src="ikon-cowok.png" alt="">Cowok</button>
    </div>
    <button id="btnMasuk">Masuk Kota</button>
  </div>
</div>

<script src="three.min.js"></script>
<script src="water.js"></script>
<script src="GLTFLoader.js"></script>
<script src="SkeletonUtils.js"></script>
<script>
/* penjaga: bila mesin 3D gagal dimuat, beri tahu polos (jangan layar kosong) */
if (typeof THREE === 'undefined') {
  var kartu27 = document.getElementById('kartuMasuk');
  if (kartu27) {
    var pesan27 = document.createElement('p');
    pesan27.style.cssText = 'margin-top:16px;font-weight:700;color:#ffe1d6;';
    pesan27.textContent = 'Mesin 3D gagal dimuat — periksa koneksi lalu muat ulang.';
    kartu27.appendChild(pesan27);
    var tombol27 = document.createElement('button');
    tombol27.innerHTML = '<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 3v4h-4"/></svg><span>Muat Ulang</span>';
    tombol27.style.cssText = 'margin-top:10px;border:none;cursor:pointer;font:inherit;font-weight:800;padding:12px 22px;border-radius:12px;background:linear-gradient(180deg,#ffd98a,#f5a83d);color:#4a2410;';
    tombol27.addEventListener('click', function(){ location.reload(); });
    kartu27.appendChild(tombol27);
  }
}
</script>
<script src="https://unpkg.com/mqtt@5.10.1/dist/mqtt.min.js"></script>
