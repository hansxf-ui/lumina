       oleh SkeletonUtils.clone di atas. getObjectByName mengembalikan
       undefined bila model lama tanpa tulang ini; semua pemakai wajib
       menjaga (blok pose terlewati, permainan tetap jalan). */
    av.betisK = model.getObjectByName('BetisKi');
    av.betisN = model.getObjectByName('BetisKa');
    av.sikuK = model.getObjectByName('SikuKi');
    av.sikuN = model.getObjectByName('SikuKa');
  }
  av.ampKaki = 0.35;      /* ayunan sopan ±20° (prosedural: 0.6) */
  av.ampLengan = 0.35;
  av.karGLB = kar;
  /* --- mixer + adaptor (model baru saja) --- */
  av.mixer = null; av.aksiJalan = null; av.aksiLari = null; av.aksiAktif = null;
  av.pakaiMixer = false; av._wDuduk = 0; av._wIdle = 0;
  if (modelBaru){
    /* ARAH HADAP (terverifikasi dari data GLB, bukan tebak): ujung hidung
       (vertex kepala z max +0,128) dan ujung sepatu (z +0,158) sama-sama
       di +Z model; sumbu +Z Hips/Head juga +Z. Model menghadap +Z glTF
       dan Lumina ry=atan2(mx,mz) menghadapkan +Z grup ke arah gerak —
       TIDAK perlu rotation.y=PI. */
