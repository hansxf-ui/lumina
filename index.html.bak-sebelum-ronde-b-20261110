    if (!tulang || !tulang.userData.qRestModel) return;
    var v = pose[kunci], qR;
    if (typeof v === 'number'){
      qR = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1, 0, 0), v);
    } else {
      var qRx = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1, 0, 0), v.x || 0);
      var qRz = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0, 0, 1), v.z || 0);
      qR = qRx.multiply(qRz);
    }
    var qTarget = qR.multiply(tulang.userData.qRestModel);
    var qCur = quatRuangModel(tulang, akar);
    var qFinal = qCur.slerp(qTarget, w);
    var qOrtu = tulang.parent ? quatRuangModel(tulang.parent, akar) : new THREE.Quaternion();
    /* .normalize() = perbaikan bug v24 (2026-11-09): invert() r128 adalah
       conjugate, bukan inverse sejati — tanpa ini, error non-unit menumpuk
       di rantai tulang dalam (jari) sampai NaN. Untuk quaternion unit: no-op. */
    tulang.quaternion.copy(qOrtu.invert().multiply(qFinal).normalize());
  });
}
function cariKlip(klips, nama){
  if (!klips) return null;
  for (var i = 0; i < klips.length; i++) if (klips[i].name === nama) return klips[i];
  return null;
}
/* pilih klip jalan/lari avatar bermixer (crossfade 0,2 dtk). mau = null
   -> fade-out 0,15 dtk (tulang kembali ke bind; mixer r128
   mengembalikan pose ikat saat action berhenti — terverifikasi Node).
   timeScale dinamis dari laju halus supaya anti-selip. */
function aturAksiMixer(av, mau, lajuHalus){
  if (!av.pakaiMixer || !av.mixer) return;
  if (mau){
    var kecKlip = mau === av.aksiLari ? (av.kecKlipRun || KEC_KLIP_RUN) : (av.kecKlipWalk || KEC_KLIP_WALK);
    mau.timeScale = Math.max(0.2, Math.min(3, lajuHalus / kecKlip));
    if (av.aksiAktif === mau) return;
    if (av.aksiAktif) av.aksiAktif.crossFadeTo(mau.reset(), 0.2, false);
    else { av.mixer.stopAllAction(); mau.reset().fadeIn(0.2).play(); }
    av.aksiAktif = mau;
  } else if (av.aksiAktif){
    av.aksiAktif.fadeOut(0.15);
    av.aksiAktif = null;
  }
}
/* Pose duduk model baru — DIPANGGIL SESUDAH mixer.update (kalau
   dipanggil sebelumnya, mixer.update menimpa tulisan tulang).
   _wDuduk diramp 0<->1 (dt*10) supaya duduk/berdiri mulus; pinggul
   (tulang Hips) ikut turun TURUN_PINGGUL_MIXAMO bersama ramp. */
function terapkanDudukMixer(av, dt){
  if (!av.pakaiMixer || !av.mixer) return;
  var targetWD = av.duduk ? 1 : 0;
  if (av._wDuduk === undefined) av._wDuduk = targetWD;
  av._wDuduk += (targetWD - av._wDuduk) * Math.min(1, dt * 10);
  if (av._wDuduk > 0.003){
    if (av.duduk) campurPoseModel(av, POSE_DUDUK_MIXAMO, av._wDuduk);
    else campurPoseModel(av, POSE_NOL_MIXAMO, 1 - av._wDuduk);
  }
  if (av.pelvis && av._pelvisRestY !== undefined)
    av.pelvis.position.y = av._pelvisRestY - (av.turunPinggul || TURUN_PINGGUL_MIXAMO) * av._wDuduk;
}

/* Pose DIAM model baru — lengan rapat ke badan (koreksi A-pose bind).
   ALASAN (diukur Node + Blender 2026-11-08): tulang bind memang cuma
   10°/16° dari vertikal, tapi KULIT lengan menggantung ~40° (offset
   skinning membesar sepanjang lengan; telapak di ±0,35 m) — itulah yang
   Ryan lihat sebagai "pose T" dan yang diukur live 30–45°. Putar tulang
   ke vertikal saja (Set A) TIDAK cukup: kulit masih ~20–30° keluar.
   Sudut di bawah (Set B, terverifikasi Blender depan+3/4+samping) memutar
   tulang MELEWATI vertikal sampai KULIT-nya rapat: lengan atas kulit
   ~12°, telapak (±0,130, 0,612, +0,106) menempel di depan paha, tangan
   X[0,088–0,148] (permukaan jeans 0,144–0,149 — tidak menembus).
   Asimetri kiri/kanan itu nyata (kulit kanan 40,82° vs kiri 40,07°) —
   pakai nilai per sisi, jangan dirata-rata. Rx +0,26 pada lengan bawah
   = ayun-mundur supaya telapak menempel (tanpa ini melayang ~5 cm).
   DIPANGGIL PALING AKHIR sesudah mixer.update + terapkanDudukMixer +
   poseLompat supaya tak ditimpa penulis pose lain; targetnya ABSOLUT
   (Rz(phi)*qRestModel) jadi dari pose awal mana pun — bind 10° maupun
   live 30–45° — lengan ditarik ke target yang sama. _wIdle diramp
   naik CEPAT dt*25 (~0,12 dtk) — sengaja cepat: kalau lambat (dt*10),
   fadeOut mixer 0,15 dtk sempat menarik lengan ke bind dulu sehingga
   telapak mengayun ke LUAR ~29 mm sebelum kembali ke dalam (reversal,
   terukur Node); dengan dt*25 koreksi mendominasi sejak awal dan telapak
   bergerak monoton ke dalam. Turun CEPAT dt*40 supaya klip jalan/lari
   langsung mengambil alih lengan. */
var POSE_IDLE_MIXAMO = {
  tanganK: { z: -0.676076 }, tanganN: { z: 0.686641 },
  sikuK: { x: 0.26, z: -0.743420 }, sikuN: { x: 0.26, z: 0.743419 }
};
/* Pose diam COWOK (Teenager, v7 — terukur + render-verifikasi 2026-11-09,
   LAPORAN-POSE-DIAM-COWOK.md). Lengan atas kulit 6,4° (bukan 22–24°:
   bahu cowok selebar paha + lengan panjang — 22° + telapak menempel
   terbukti tak kompatibel, celah 84–131 mm), siku 8,0°, telapak di
   depan paha (z +0,09) celah 1,1 mm, jari rapat bawaan mesh (tidak ada
   tulang jari; tangan ikut ForeArm, tidak diputar terpisah). */
var POSE_IDLE_COWOK_MIXAMO = {
  tanganK: { x: -0.087, z: -0.553 }, tanganN: { x: -0.09, z: 0.586 },
  sikuK: { x: -0.024, z: -0.769 }, sikuN: { x: -0.01, z: 0.745 }
};
function terapkanIdleMixer(av, dt, sedangLompat){
  if (!av.pakaiMixer || !av.mixer) return;
  var idle = !av.aksiAktif && !av.duduk && !sedangLompat && (av._wDuduk === undefined || av._wDuduk < 0.05);
  if (av._wIdle === undefined) av._wIdle = idle ? 1 : 0;
  var laju = idle ? dt * 25 : dt * 40;
  av._wIdle += ((idle ? 1 : 0) - av._wIdle) * Math.min(1, laju);
  if (av._wIdle > 0.003) campurPoseModel(av, av.poseIdle || POSE_IDLE_MIXAMO, av._wIdle);
}

/* Cari node tulang model GLB berdasarkan NAMA ASLI file (mis.
   'mixamorig:Hips'). ALASAN (bug 2026-11-08, avatar cewek tak tampil):
   GLTFLoader.js bundel adalah versi MODERN — loadNode memakai
   createUniqueName -> PropertyBinding.sanitizeNodeName, yang MEMBUANG
   ':' (dan karakter non-alfanumerik lain) dari nama node saat muat.
   Di scene hasil muat, tulang bernama 'mixamorigHips' (bukan
   'mixamorig:Hips'); nama asli tersimpan di node.userData.name.
   getObjectByName('mixamorig:Hips') mengembalikan null -> modelBaru
   false -> pemetaan Indonesia semuanya undefined -> animasiAvatar
   prosedural throw tiap frame di av.kakiK.rotation.x dan
   renderer.render tak pernah jalan (kanvas beku, avatar tak terlihat).
   Pencarian: userData.name dulu (nama asli, paling tepercaya), lalu
   nama persis, lalu nama ter-sanitize (':' dibuang). */
function cariNodeGLB(model, namaAsli){
  var ketemu = null;
  var namaSan = namaAsli.replace(/[^a-zA-Z0-9_\-]/g, '');
  model.traverse(function(o){
    if (ketemu) return;
    if ((o.userData && o.userData.name === namaAsli) || o.name === namaAsli || o.name === namaSan) ketemu = o;
  });
  return ketemu;
}

function buatAvatarKarakter(kar, warnaHex, nama, tanpaLabel){
  var tpl = modelKarakter[kar];
  if (!tpl){
    var avF = buatAvatar(warnaDariNama(nama), nama, tanpaLabel);
    avF.karFallback = kar;   /* penanda: tukar ke GLB bila preload selesai (pemain lokal) */
    return avF;
  }
  var av = buatAvatar(warnaHex, nama, tanpaLabel);
  av.isi.traverse(function(o){ if (o.isMesh) o.visible = false; });
  var model = (THREE.SkeletonUtils ? THREE.SkeletonUtils.clone(tpl) : tpl.clone(true));   /* model berkulit: klon WAJIB bawa skeleton sendiri, klon polos berbagi skeleton -> pose antar-pemain saling menimpa */
