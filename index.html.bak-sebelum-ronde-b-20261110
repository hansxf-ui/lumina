(function(){
  var inputNama = $('nama');
  inputNama.value = namaSaya;
  var pilKar = $('pilKar');
  if (pilKar){
    pilKar.querySelectorAll('.pilKarBtn').forEach(function(b){
      b.classList.toggle('pilih', b.getAttribute('data-kar') === karSaya);
      b.addEventListener('click', function(){
        karSaya = (b.getAttribute('data-kar') === 'cowok') ? 'cowok' : 'cewek';
        pilKar.querySelectorAll('.pilKarBtn').forEach(function(x){ x.classList.toggle('pilih', x === b); });
      });
    });
  }
  function masuk(){
    /* auto-landscape: fullscreen + kunci landscape (Android Chrome bisa;
       Safari iPhone tidak mengizinkan kunci -> overlay putar-HP yang memandu) */
    try {
      var deM = document.documentElement;
      if (deM.requestFullscreen) { var pfM = deM.requestFullscreen(); if (pfM && pfM.catch) pfM.catch(function(){}); }
      if (screen.orientation && screen.orientation.lock) { var plM = screen.orientation.lock('landscape'); if (plM && plM.catch) plM.catch(function(){}); }
    } catch (eM) {}
    var v = inputNama.value.trim();
    namaSaya = (v || namaSaya).slice(0, 16);
    /* localStorage TIDAK BOLEH menggagalkan masuk: di iPhone yang
       penyimpanannya penuh/dibatasi, setItem bisa throw dan membatalkan
       seluruh masuk() (kartu nyangkut, game tak mulai) — padahal di
       Android aman. Bungkus, gagal simpan = lanjut saja. */
    try {
      localStorage.setItem('lumina.nama', namaSaya);
      localStorage.setItem('lumina.warna', String(warnaSaya));
      localStorage.setItem('lumina.kar', karSaya);
    } catch (eLS) {}
    scene.remove(pemain.av.grup);
