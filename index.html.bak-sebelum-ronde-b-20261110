      if (!t) return;
      t.userData.qRestLokal = t.quaternion.clone();
      t.userData.qRestModel = quatRuangModel(t, model);
    });
    if (av.pelvis) av._pelvisRestY = av.pelvis.position.y;   /* Hips rest 0,681 */
    var klips = klipKarakter[kar] || [];
