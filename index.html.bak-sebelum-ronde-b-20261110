    var cv = document.createElement('canvas'); cv.width = cv.height = 512;
    var x = cv.getContext('2d');
    x.fillStyle = '#a5834f'; x.fillRect(0, 0, 512, 512);
    /* ubin 128px dengan variasi warna hangat halus */
