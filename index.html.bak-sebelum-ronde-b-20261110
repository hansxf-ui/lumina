(function(){
  /* mesh bukit digenerasi dari tinggiBukit() yang sama persis dengan
     fungsi tanah — warna vertex: rumput bervariasi + jalur tanah di landai */
  var SEG = 58, UK = 40;
  var geo = new THREE.PlaneGeometry(UK, UK, SEG, SEG);
  geo.rotateX(-Math.PI / 2);
  var pos = geo.attributes.position;
  var warnaArr = new Float32Array(pos.count * 3);
  var cRumputA = new THREE.Color(0x5cb84a), cRumputB = new THREE.Color(0x49953a);
  var cPuncak = new THREE.Color(0x74cc5e), cJalur = new THREE.Color(0xb99c6b);
  var cc = new THREE.Color();
  var i, vx, vz, d, a, h;
  for (i = 0; i < pos.count; i++){
    vx = pos.getX(i) + BUKIT.x;
    vz = pos.getZ(i) + BUKIT.z;
    d = Math.hypot(vx - BUKIT.x, vz - BUKIT.z);
    a = Math.atan2(vz - BUKIT.z, vx - BUKIT.x);
    if (d > 19.4) { pos.setY(i, -0.9); }
    else pos.setY(i, tinggiBukit(d, a) + 0.02);
    /* warna */
    var noise = 0.5 + 0.5 * Math.sin(vx * 12.9898 + vz * 78.233);
    cc.copy(cRumputA).lerp(cRumputB, noise);
    if (d < 5.5) cc.lerp(cPuncak, 0.45);
    var fJalur = 0;
    if (d >= 12.5 && d < 17.5) fJalur = Math.max(fJalur, sektor(a, LANDAI1));
    if (d >= 8 && d < 12.5) fJalur = Math.max(fJalur, sektor(a, LANDAI2));
    if (d >= 4.5 && d < 8) fJalur = Math.max(fJalur, sektor(a, LANDAI3));
    if (fJalur > 0.35) cc.lerp(cJalur, (fJalur - 0.35) / 0.65 * 0.85);
    warnaArr[i * 3] = cc.r; warnaArr[i * 3 + 1] = cc.g; warnaArr[i * 3 + 2] = cc.b;
  }
  geo.setAttribute('color', new THREE.BufferAttribute(warnaArr, 3));
  geo.computeVertexNormals();
  var bukit = new THREE.Mesh(geo, new THREE.MeshLambertMaterial({ vertexColors:true }));
  bukit.position.set(BUKIT.x, 0, BUKIT.z);
  bukit.receiveShadow = true;
  scene.add(bukit);

  /* pohon ikonik besar di puncak — kini GLB pohon berskala besar
     (tinggi lama ±6.6 → skala 6.6/2.90 ≈ 2.28); collider tak berubah */
  catatPohon(39.5, tinggiTanah(39.5, 34.5), 34.5, null, 2.28, 'taman', true); /* #B3: penabrak r=1,15 di bawah dipertahankan — jangan dobel */
  penabrak.push({ x:39.5, z:34.5, r:1.15 });

  /* pohon-pohon taman di teras (hindari jalur landai) */
  [[14.5, -0.6], [15.5, 1.6], [10.5, -2.9], [10, 2.0], [6.2, 1.2], [15, -1.25], [11, 3.05]].forEach(function(t, i){
    var px = BUKIT.x + Math.cos(t[1]) * t[0];
    var pz = BUKIT.z + Math.sin(t[1]) * t[0];
    var s = 0.9 + (i % 3) * 0.15;
    catatPohon(px, tinggiTanah(px, pz), pz, null, s * 1.122, 'taman');
  });

  /* hamparan bunga di teras-teras — satu InstancedMesh */
  var JML_BUNGA = 170;
  var instBunga = new THREE.InstancedMesh(
    new THREE.SphereGeometry(0.11, 6, 5),
    new THREE.MeshLambertMaterial({ color:0xffffff }),
    JML_BUNGA
  );
  var warnaBunga = [0xe2543e, 0xf276b3, 0xffd23e, 0xffffff, 0xb565a7, 0xf2a03d];
  var m4 = new THREE.Matrix4(), q0 = new THREE.Quaternion(), pv = new THREE.Vector3(), sv = new THREE.Vector3();
  var idx = 0, jaga = 0;
  while (idx < JML_BUNGA && jaga < 3000){
    jaga++;
    var aa = Math.random() * Math.PI * 2;
    var dd = 2 + Math.random() * 15.5;
    var fJ = 0;
    if (dd >= 12.5) fJ = sektor(aa, LANDAI1);
    else if (dd >= 8) fJ = sektor(aa, LANDAI2);
    else if (dd >= 4.5) fJ = sektor(aa, LANDAI3);
    if (fJ > 0.7) continue; /* jangan di tengah jalur */
    var bx = BUKIT.x + Math.cos(aa) * dd;
    var bz = BUKIT.z + Math.sin(aa) * dd;
    var s = 0.8 + Math.random() * 0.7;
    pv.set(bx, tinggiTanah(bx, bz) + 0.1, bz);
    sv.set(s, s, s);
    m4.compose(pv, q0, sv);
    instBunga.setMatrixAt(idx, m4);
    instBunga.setColorAt(idx, new THREE.Color(warnaBunga[idx % warnaBunga.length]));
    idx++;
  }
  instBunga.count = idx;
  instBunga.instanceMatrix.needsUpdate = true;
  if (instBunga.instanceColor) instBunga.instanceColor.needsUpdate = true;
